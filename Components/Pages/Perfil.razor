@page "/perfil"
@attribute [Authorize]
@using System.Security.Claims
@using Sistema_de_Gestion_de_Activos.Application.DTOs.Usuarios
@using Sistema_de_Gestion_de_Activos.Application.Interfaces
@inject Microsoft.AspNetCore.Components.Authorization.AuthenticationStateProvider AuthStateProvider
@inject IUsuarioService UsuarioService

<PageTitle>Mi perfil</PageTitle>
@if (profile is not null)
{
    <div class="mb-6"><p class="text-sm font-medium text-primary-600">Cuenta</p>
        <h1 class="text-2xl font-bold">Mi perfil</h1>
        <p class="mt-1 text-sm text-gray-500">Administre la información visible de su cuenta.</p>
    </div>

    @if (!string.IsNullOrEmpty(message)) { 
        <div class="mb-4 rounded-lg border border-green-200 bg-green-50 px-4 py-3 text-sm text-green-800 dark:border-green-900 dark:bg-green-950/40 dark:text-green-200">@message</div> }
    <section class="overflow-hidden rounded-2xl border border-gray-200 bg-white shadow-sm dark:border-gray-800 dark:bg-gray-900">
        <div class="h-28 bg-gradient-to-r from-primary-700 to-primary-500"></div>
        <div class="px-6 pb-6">
            <div class="-mt-12 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
            <span class="grid h-24 w-24 place-items-center rounded-2xl border-4 border-white bg-primary-100 text-3xl font-bold text-primary-700 shadow-sm dark:border-gray-900 dark:bg-primary-900 dark:text-primary-100">@profile.Nombre[..1].ToUpperInvariant()</span>
            <button class="rounded-lg border border-gray-300 px-4 py-2 text-sm font-semibold transition hover:bg-gray-50 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary-500 dark:border-gray-700 dark:hover:bg-gray-800" @onclick="OpenEdit">Editar perfil</button>
        </div>
        <h2 class="mt-4 text-xl font-bold">@profile.Nombre</h2>
        <p class="text-sm text-gray-500">@role</p><dl class="mt-7 grid gap-5 border-t border-gray-100 pt-6 sm:grid-cols-2 dark:border-gray-800">
        <div>
            <dt class="text-xs font-semibold uppercase tracking-wide text-gray-500">
                Correo electrónico
            </dt>
            <dd class="mt-1">@profile.Correo</dd>
        </div>
        <div>
            <dt class="text-xs font-semibold uppercase tracking-wide text-gray-500">
                Rol
            </dt>
            <dd class="mt-1">@role</dd>
        </div>
        <div>
            <dt class="text-xs font-semibold uppercase tracking-wide text-gray-500">
                Estado
            </dt>
        <dd class="mt-1">
            <span class="rounded-full bg-green-100 px-2.5 py-1 text-xs font-semibold text-green-700 dark:bg-green-950/50 dark:text-green-300">@profile.Estado</span>
        </dd>
        </div>
        <div>
            <dt class="text-xs font-semibold uppercase tracking-wide text-gray-500">Identificador de cuenta</dt>
            <dd class="mt-1 break-all font-mono text-xs text-gray-600 dark:text-gray-300">@profile.Id</dd>
        </div>
        </dl>
        </div>
        </section>
}

<Modal @bind-IsOpen="editing" Title="Editar mi perfil">
    <EditForm Model="edit" OnValidSubmit="Save">
        <DataAnnotationsValidator />
        <div>
            <label class="mb-1 block text-sm font-semibold">Nombre</label>
            <InputText class="w-full rounded-lg border border-gray-300 px-3 py-2 dark:border-gray-700 dark:bg-gray-800" @bind-Value="edit.Nombre" />
        </div>
        <p class="mt-3 text-xs text-gray-500">Por seguridad, los cambios de correo y contraseña se realizan mediante el flujo de administración o recuperación de contraseña.</p>
        <div class="mt-6 flex justify-end gap-2"><button type="button" class="rounded-lg px-4 py-2 text-sm font-semibold hover:bg-gray-100 dark:hover:bg-gray-800" @onclick="() => editing = false">Cancelar</button><button type="submit" class="rounded-lg bg-primary-600 px-4 py-2 text-sm font-semibold text-white hover:bg-primary-700">Guardar</button></div></EditForm></Modal>

@code {
    private UsuarioResponseDto? profile; private UsuarioUpdateDto edit = new(); private string role = "Usuario", message = ""; private bool editing;
    protected override async Task OnInitializedAsync() { var state = await AuthStateProvider.GetAuthenticationStateAsync(); var idText = state.User.FindFirstValue(ClaimTypes.NameIdentifier); role = state.User.FindFirstValue(ClaimTypes.Role) ?? role; if (Guid.TryParse(idText, out var id)) profile = (await UsuarioService.ObtenerTodosAsync()).FirstOrDefault(x => x.Id == id); }
    private void OpenEdit() { if (profile is null) return; edit = new() { Nombre = profile.Nombre }; editing = true; }
    private async Task Save() { if (profile is null) return; var updated = await UsuarioService.ActualizarUsuarioAsync(profile.Id, edit); if (updated is not null) { profile = updated; message = "Perfil actualizado."; } editing = false; }
}
