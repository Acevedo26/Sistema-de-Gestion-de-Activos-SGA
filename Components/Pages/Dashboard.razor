@page "/dashboard"
@page "/"
@attribute [Authorize]
@using Sistema_de_Gestion_de_Activos.Application.DTOs.Dashboard
@using Sistema_de_Gestion_de_Activos.Application.Interfaces
@inject IDashboardService DashboardService
@inject NavigationManager Navigation
@implements IDisposable

<PageTitle>Dashboard - SGA</PageTitle>

<div class="mb-6 flex flex-col md:flex-row md:items-center justify-between gap-4">
    <div>
        <h1 class="text-2xl font-bold text-gray-900 dark:text-white">Dashboard</h1>
        <p class="text-sm text-gray-500 dark:text-gray-400">Resumen general del estado de los activos y mantenimientos.</p>
    </div>
    <button type="button" @onclick="ReloadManual" class="text-gray-500 hover:text-gray-900 dark:hover:text-white transition-colors" title="Actualizar datos">
        <svg class="w-5 h-5 @(isReloading ? "animate-spin" : "")" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"></path><path d="M3 3v5h5"></path></svg>
    </button>
</div>

@if (Kpis == null)
{
    <!-- Skeleton Loaders -->
    <div class="grid grid-cols-1 md:grid-cols-2 md:grid-cols-3 gap-6 mb-8">
        @for(int i=0; i<3; i++) {
            <div class="bg-white dark:bg-gray-800 rounded-xl shadow-sm border border-gray-200 dark:border-gray-700 p-6 animate-pulse">
                <div class="flex items-center gap-4 mb-4">
                    <div class="w-10 h-10 rounded bg-gray-200 dark:bg-gray-700"></div>
                    <div class="flex-1 h-4 bg-gray-200 dark:bg-gray-700 rounded w-1/2"></div>
                </div>
                <div class="h-8 bg-gray-200 dark:bg-gray-700 rounded w-3/4 mb-2"></div>
                <div class="h-3 bg-gray-200 dark:bg-gray-700 rounded w-1/3"></div>
            </div>
        }
    </div>
}
else
{
    <!-- Tarjetas KPI -->
    <div class="grid grid-cols-1 md:grid-cols-2 md:grid-cols-3 gap-6 mb-8">
        
        <!-- Total de Activos -->
        <div class="bg-white dark:bg-gray-800 rounded-xl shadow-sm border border-gray-200 dark:border-gray-700 p-6 relative overflow-hidden flex flex-col justify-between cursor-pointer hover:shadow-md transition-shadow" @onclick='() => Navigation.NavigateTo("/activos")'>
            <div class="flex items-center gap-3 mb-2 text-gray-500 dark:text-gray-400 font-medium">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path><polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline><line x1="12" y1="22.08" x2="12" y2="12"></line></svg>
                Total de Activos
            </div>
            <div class="flex items-end justify-between">
                <div>
                    <h2 class="text-3xl font-bold text-gray-900 dark:text-white">@Kpis.TotalActivos</h2>
                    <p class="text-sm mt-1 @(Kpis.ActivosNuevosMes > 0 ? "text-green-500" : "text-gray-500 dark:text-gray-400")">
                        @(Kpis.ActivosNuevosMes > 0 ? $"+{Kpis.ActivosNuevosMes} activos este mes" : "Sin activos nuevos este mes")
                    </p>
                </div>
                <!-- Dynamic Sparkline --><svg class="w-16 h-8 text-primary-500 opacity-60" viewBox="0 0 100 30" preserveAspectRatio="none"><path d="@GetSparklineFillInt(Kpis.TendenciaActivos)" fill="currentColor" fill-opacity="0.1"/><path d="@GetSparklinePathInt(Kpis.TendenciaActivos)" fill="none" stroke="currentColor" stroke-width="2"/></svg>
            </div>
        </div>

        <!-- Estado de Depreciación -->
        <div class="bg-white dark:bg-gray-800 rounded-xl shadow-sm border border-gray-200 dark:border-gray-700 p-6 flex flex-col justify-between">
            <div class="flex items-center gap-3 mb-4 text-gray-500 dark:text-gray-400 font-medium">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"></polyline></svg>
                Estado de Depreciación
            </div>
            <div class="flex items-center gap-6">
                                <!-- SVG Donut Chart -->
                <div class="relative w-20 h-20 shrink-0 flex items-center justify-center">
                    <svg viewBox="0 0 120 120" class="w-20 h-20 transform -rotate-90">
                        <circle cx="60" cy="60" r="54" fill="none" stroke="currentColor" stroke-width="12" class="text-gray-200 dark:text-gray-700" />
                        <circle cx="60" cy="60" r="54" fill="none" stroke="currentColor" stroke-width="12" class="text-primary-600 transition-all duration-1000 ease-out"
                                stroke-dasharray="339.292" stroke-dashoffset="@(339.292 * (1 - (double.IsNaN(Kpis.PorcentajeDepreciados) || double.IsInfinity(Kpis.PorcentajeDepreciados) ? 0 : Kpis.PorcentajeDepreciados / 100.0)))" stroke-linecap="round" />
                    </svg>
                    <div class="absolute inset-0 flex items-center justify-center flex-col">
                        <span class="text-xs font-bold text-gray-900 dark:text-white">@(double.IsNaN(Kpis.PorcentajeDepreciados) || double.IsInfinity(Kpis.PorcentajeDepreciados) ? 0 : Math.Round(Kpis.PorcentajeDepreciados))%</span>
                    </div>
                </div>
                <div>
                    <h2 class="text-2xl font-bold text-gray-900 dark:text-white">@Kpis.ActivosDepreciados <span class="text-sm font-normal text-gray-500">activos</span></h2>
                    <p class="text-xs text-gray-500 dark:text-gray-400 leading-tight mt-1">completamente depreciados o al final de su vida útil.</p>
                </div>
            </div>
        </div>

        <!-- Valor Actual Total -->
        <div class="bg-white dark:bg-gray-800 rounded-xl shadow-sm border border-gray-200 dark:border-gray-700 p-6 flex flex-col justify-between">
            <div class="flex items-center gap-3 mb-2 text-gray-500 dark:text-gray-400 font-medium">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"></circle><path d="M16 8h-6a2 2 0 1 0 0 4h4a2 2 0 1 1 0 4H8"></path><path d="M12 18V6"></path></svg>
                Valor Actual Total
            </div>
            <div>
                <h2 class="text-2xl font-bold text-gray-900 dark:text-white">@Sistema_de_Gestion_de_Activos.Services.DashboardService.FormatearMoneda(Kpis.ValorActualTotal)</h2>
                <p class="text-xs text-gray-500 dark:text-gray-400 mt-1">Depreciación acumulada: @Sistema_de_Gestion_de_Activos.Services.DashboardService.FormatearMoneda(Kpis.DepreciacionAcumuladaTotal)</p>
            </div>
            <!-- Dynamic Sparkline Fill --><svg class="w-full h-8 text-primary-500 opacity-30 mt-2" viewBox="0 0 100 30" preserveAspectRatio="none"><path d="@GetSparklineFill(Kpis.TendenciaValor)" fill="currentColor" fill-opacity="0.3"/></svg>
        </div>
            </div>

    <!-- Layout Grid Inferior -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        
        <!-- Alertas de Mantenimiento -->
        <div class="lg:col-span-2 bg-white dark:bg-gray-800 rounded-xl shadow-sm border border-red-100 dark:border-red-900/30 overflow-hidden">
            <div class="p-6 border-b border-gray-100 dark:border-gray-800 flex justify-between items-center bg-red-50/50 dark:bg-red-900/10">
                <h3 class="text-lg font-semibold text-gray-900 dark:text-white flex items-center gap-2">
                    <svg class="w-5 h-5 text-red-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
                    Alertas de Mantenimiento
                </h3>
            </div>
            
            <div class="divide-y divide-gray-100 dark:divide-gray-800">
                @if (Alertas == null || !Alertas.Any())
                {
                    <div class="p-6 text-center text-gray-500 dark:text-gray-400">No hay mantenimientos próximos.</div>
                }
                else
                {
                    @foreach (var alerta in Alertas)
                    {
                        var colorUrge = alerta.EstadoUrgencia switch {
                            "Rojo" => "text-red-500",
                            "Amarillo" => "text-yellow-500",
                            _ => "text-green-500"
                        };
                        var textUrge = alerta.DiasRestantes switch {
                            < 0 => $"Vencido hace {Math.Abs(alerta.DiasRestantes)} días",
                            0 => "Vence: Hoy",
                            1 => "Vence: Mañana",
                            _ => $"Vence en {alerta.DiasRestantes} días"
                        };

                        <div class="p-4 flex items-center justify-between hover:bg-gray-50 dark:hover:bg-gray-800/50 transition-colors">
                            <div>
                                <h4 class="text-sm font-semibold text-gray-900 dark:text-white">@alerta.NombreActivo</h4>
                                <p class="text-xs mt-1 @colorUrge font-medium">@textUrge</p>
                            </div>
                            <a href="/mantenimientos" class="px-3 py-1.5 text-xs font-medium text-gray-700 bg-white border border-gray-300 rounded-lg hover:bg-gray-50 dark:bg-gray-800 dark:border-gray-600 dark:text-gray-300 dark:hover:bg-gray-700">Ver</a>
                        </div>
                    }
                }
            </div>
        </div>

        <!-- Actividad Reciente -->
        <div class="bg-white dark:bg-gray-800 rounded-xl shadow-sm border border-gray-200 dark:border-gray-700 p-6 overflow-hidden">
            <h3 class="text-lg font-semibold text-gray-900 dark:text-white flex items-center gap-2 mb-6">
                <svg class="w-5 h-5 text-gray-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"></polyline></svg>
                Actividad Reciente
            </h3>
            
            <div class="space-y-6">
                @if (Actividades == null || !Actividades.Any())
                {
                    <p class="text-sm text-gray-500 text-center">No hay actividad registrada.</p>
                }
                else
                {
                    @foreach (var act in Actividades)
                    {
                        var icon = act.TipoEvento.Contains("Creado") ? "M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6" : 
                                   act.TipoEvento.Contains("Mantenimiento") ? "M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z" :
                                   "M5 12h14M12 5l7 7-7 7";

                        <div class="flex gap-4">
                            <div class="relative shrink-0 flex items-center justify-center w-8 h-8 rounded-full bg-gray-100 dark:bg-gray-700">
                                <svg class="w-4 h-4 text-gray-500" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="@icon"></path></svg>
                                <div class="absolute top-8 w-px h-8 bg-gray-200 dark:bg-gray-700 last:hidden"></div>
                            </div>
                            <div>
                                <h4 class="text-sm font-semibold text-gray-900 dark:text-white">@act.TipoEvento</h4>
                                <p class="text-xs text-gray-500 dark:text-gray-400 mt-0.5">@act.Descripcion</p>
                                <p class="text-xs text-gray-400 dark:text-gray-500 mt-1 flex items-center gap-1">
                                    <svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
                                    @act.TiempoRelativo
                                </p>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>
        
    </div>
}

@code {
    private DashboardKpiDto? Kpis;
    private List<AlertaMantenimientoDto>? Alertas;
    private List<ActividadRecienteDto>? Actividades;
    private bool isReloading;
    private System.Threading.Timer? _timer;

    protected override async Task OnInitializedAsync()
    {
        await LoadDashboardData();
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
        {
            _timer = new System.Threading.Timer(async _ =>
            {
                await InvokeAsync(async () =>
                {
                    await LoadDashboardData();
                    StateHasChanged();
                });
            }, null, 60000, 60000);
        }
    }

    private async Task ReloadManual()
    {
        isReloading = true;
        StateHasChanged();
        await LoadDashboardData();
        isReloading = false;
        StateHasChanged();
    }

    private async Task LoadDashboardData()
    {
        Kpis = await DashboardService.GetKPIsAsync();
        Alertas = await DashboardService.GetAlertasMantenimientoAsync();
        Actividades = await DashboardService.GetActividadRecienteAsync();
    }

        private string GetSparklinePath(List<decimal> values)
    {
        if (values == null || values.Count < 2) return "M0 30 L100 30";
        var max = values.Max();
        var min = values.Min();
        if (max == min) return "M0 15 L100 15";
        var width = 100.0m;
        var height = 28.0m;
        var stepX = width / (values.Count - 1);
        var points = new List<string>();
        for (int i = 0; i < values.Count; i++)
        {
            var x = i * stepX;
            var y = 30.0m - (((values[i] - min) / (max - min)) * height);
            points.Add($"{(i == 0 ? "M" : "L")}{x.ToString(System.Globalization.CultureInfo.InvariantCulture)} {y.ToString(System.Globalization.CultureInfo.InvariantCulture)}");
        }
        return string.Join(" ", points);
    }
    private string GetSparklinePathInt(List<int> values) => GetSparklinePath(values?.Select(v => (decimal)v).ToList() ?? new());
    private string GetSparklineFill(List<decimal> values) => $"{GetSparklinePath(values)} V30 H0 Z";
    private string GetSparklineFillInt(List<int> values) => GetSparklineFill(values?.Select(v => (decimal)v).ToList() ?? new());

    public void Dispose()
    {
        _timer?.Dispose();
    }
}