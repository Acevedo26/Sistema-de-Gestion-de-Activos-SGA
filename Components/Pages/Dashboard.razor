@page "/dashboard"
@page "/"
@attribute [Authorize]
@using Sistema_de_Gestion_de_Activos.Application.DTOs.Dashboard
@using Sistema_de_Gestion_de_Activos.Application.Interfaces
@inject IDashboardService DashboardService
@inject NavigationManager Navigation
@inject IJSRuntime JS
@implements IDisposable

<PageTitle>Dashboard - SGA</PageTitle>

<div class="mb-6 flex flex-col md:flex-row md:items-center justify-between gap-4">
    <div>
        <h1 class="text-2xl font-bold text-gray-900 dark:text-white">Dashboard</h1>
        <p class="text-sm text-gray-500 dark:text-gray-400">Resumen general del estado de los activos y mantenimientos.</p>
    </div>
    <button type="button" @onclick="ReloadManual" class="text-gray-500 hover:text-gray-900 dark:hover:text-white transition-colors" title="Actualizar datos">
        <svg class="w-5 h-5 @(isReloading ? "animate-spin" : "")" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"></path><path d="M3 3v5h5"></path></svg>
    </button>
</div>

@if (Kpis == null)
{
    <!-- Skeleton Loaders -->
    <div class="grid grid-cols-1 md:grid-cols-2 md:grid-cols-3 gap-6 mb-8">
        @for(int i=0; i<3; i++) {
            <div class="bg-white dark:bg-gray-800 rounded-xl shadow-sm border border-gray-200 dark:border-gray-700 p-6 animate-pulse">
                <div class="flex items-center gap-4 mb-4">
                    <div class="w-10 h-10 rounded bg-gray-200 dark:bg-gray-700"></div>
                    <div class="flex-1 h-4 bg-gray-200 dark:bg-gray-700 rounded w-1/2"></div>
                </div>
                <div class="h-8 bg-gray-200 dark:bg-gray-700 rounded w-3/4 mb-2"></div>
                <div class="h-3 bg-gray-200 dark:bg-gray-700 rounded w-1/3"></div>
            </div>
        }
    </div>
}
else
{
    <!-- Tarjetas KPI -->
    <div class="grid grid-cols-1 md:grid-cols-2 md:grid-cols-3 gap-6 mb-8">
        
        <!-- Total de Activos -->
        <div class="bg-white dark:bg-gray-800 rounded-xl shadow-sm border border-gray-200 dark:border-gray-700 p-4 md:p-6 w-full cursor-pointer hover:shadow-md transition-shadow" @onclick='() => Navigation.NavigateTo("/activos")'>
            <div class="flex justify-between items-start">
                <div>
                    <h5 class="text-2xl font-bold text-gray-900 dark:text-white">@Kpis.TotalActivos</h5>
                    <p class="text-sm text-gray-500 dark:text-gray-400">Total de Activos</p>
                </div>
                <div class="flex items-center px-2.5 py-0.5 font-medium text-green-500 text-center">
                    <svg class="w-5 h-5" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v13m0-13 4 4m-4-4-4 4"/></svg>
                    @(Kpis.ActivosNuevosMes > 0 ? $"+{Kpis.ActivosNuevosMes}" : "0")
                </div>
            </div>
            <div id="chart-activos" class="py-4 md:py-6"></div>
        </div>

        <!-- Estado de Depreciación -->
        <div class="bg-white dark:bg-gray-800 rounded-xl shadow-sm border border-gray-200 dark:border-gray-700 p-4 md:p-6 w-full relative">
            <div class="flex justify-between items-start mb-3">
                <div class="flex justify-center items-center">
                    <h5 class="text-xl font-semibold text-gray-900 dark:text-white me-1">Estado de Depreciación</h5>
                </div>
            </div>

            <div>
                <div class="flex" id="devices">
                    <div class="flex items-center me-4">
                        <span class="w-3 h-3 rounded-full bg-primary-600 me-2"></span>
                        <span class="text-sm font-medium text-gray-900 dark:text-white">Depreciados</span>
                    </div>
                    <div class="flex items-center me-4">
                        <span class="w-3 h-3 rounded-full bg-gray-200 dark:bg-gray-600 me-2"></span>
                        <span class="text-sm font-medium text-gray-900 dark:text-white">En Vida Útil</span>
                    </div>
                </div>
            </div>

            <!-- Donut Chart -->
            <div class="py-2" id="donut-chart"></div>
        </div>

        <!-- Valor Actual Total -->
        <div class="bg-white dark:bg-gray-800 rounded-xl shadow-sm border border-gray-200 dark:border-gray-700 p-4 md:p-6 w-full cursor-pointer hover:shadow-md transition-shadow" @onclick='() => Navigation.NavigateTo("/activos")'>
            <div class="flex justify-between items-start">
                <div>
                    <h5 class="text-2xl font-bold text-gray-900 dark:text-white">@Sistema_de_Gestion_de_Activos.Services.DashboardService.FormatearMoneda(Kpis.ValorActualTotal)</h5>
                    <p class="text-sm text-gray-500 dark:text-gray-400">Valor Actual Total</p>
                </div>
            </div>
            <div id="chart-valor" class="py-4 md:py-6"></div>
        </div>
            </div>

    <!-- Layout Grid Inferior -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        
        <!-- Alertas de Mantenimiento -->
        <div class="lg:col-span-2 bg-white dark:bg-gray-800 rounded-xl shadow-sm border border-red-100 dark:border-red-900/30 overflow-hidden">
            <div class="p-6 border-b border-gray-100 dark:border-gray-800 flex justify-between items-center bg-red-50/50 dark:bg-red-900/10">
                <h3 class="text-lg font-semibold text-gray-900 dark:text-white flex items-center gap-2">
                    <svg class="w-5 h-5 text-red-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
                    Alertas de Mantenimiento
                </h3>
            </div>
            
            <div class="divide-y divide-gray-100 dark:divide-gray-800">
                @if (Alertas == null || !Alertas.Any())
                {
                    <div class="p-6 text-center text-gray-500 dark:text-gray-400">No hay mantenimientos próximos.</div>
                }
                else
                {
                    @foreach (var alerta in Alertas)
                    {
                        var colorUrge = alerta.EstadoUrgencia switch {
                            "Rojo" => "text-red-500",
                            "Amarillo" => "text-yellow-500",
                            _ => "text-green-500"
                        };
                        var textUrge = alerta.DiasRestantes switch {
                            < 0 => $"Vencido hace {Math.Abs(alerta.DiasRestantes)} días",
                            0 => "Vence: Hoy",
                            1 => "Vence: Mañana",
                            _ => $"Vence en {alerta.DiasRestantes} días"
                        };

                        <div class="p-4 flex items-center justify-between hover:bg-gray-50 dark:hover:bg-gray-800/50 transition-colors">
                            <div>
                                <h4 class="text-sm font-semibold text-gray-900 dark:text-white">@alerta.NombreActivo</h4>
                                <p class="text-xs mt-1 @colorUrge font-medium">@textUrge</p>
                            </div>
                            <a href="/mantenimientos" class="px-3 py-1.5 text-xs font-medium text-gray-700 bg-white border border-gray-300 rounded-lg hover:bg-gray-50 dark:bg-gray-800 dark:border-gray-600 dark:text-gray-300 dark:hover:bg-gray-700">Ver</a>
                        </div>
                    }
                }
            </div>
        </div>

        <!-- Actividad Reciente -->
        <div class="bg-white dark:bg-gray-800 rounded-xl shadow-sm border border-gray-200 dark:border-gray-700 p-6 overflow-hidden">
            <h3 class="text-lg font-semibold text-gray-900 dark:text-white flex items-center gap-2 mb-6">
                <svg class="w-5 h-5 text-gray-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"></polyline></svg>
                Actividad Reciente
            </h3>
            
            <div class="space-y-6">
                @if (Actividades == null || !Actividades.Any())
                {
                    <p class="text-sm text-gray-500 text-center">No hay actividad registrada.</p>
                }
                else
                {
                    @foreach (var act in Actividades)
                    {
                        var icon = act.TipoEvento.Contains("Creado") ? "M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6" : 
                                   act.TipoEvento.Contains("Mantenimiento") ? "M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z" :
                                   "M5 12h14M12 5l7 7-7 7";

                        <div class="flex gap-4">
                            <div class="relative shrink-0 flex items-center justify-center w-8 h-8 rounded-full bg-gray-100 dark:bg-gray-700">
                                <svg class="w-4 h-4 text-gray-500" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="@icon"></path></svg>
                                <div class="absolute top-8 w-px h-8 bg-gray-200 dark:bg-gray-700 last:hidden"></div>
                            </div>
                            <div>
                                <h4 class="text-sm font-semibold text-gray-900 dark:text-white">@act.TipoEvento</h4>
                                <p class="text-xs text-gray-500 dark:text-gray-400 mt-0.5">@act.Descripcion</p>
                                <p class="text-xs text-gray-400 dark:text-gray-500 mt-1 flex items-center gap-1">
                                    <svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
                                    @act.TiempoRelativo
                                </p>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>
        
    </div>
}

@code {
    private DashboardKpiDto? Kpis;
    private List<AlertaMantenimientoDto>? Alertas;
    private List<ActividadRecienteDto>? Actividades;
    private bool isReloading;
    private System.Threading.Timer? _timer;

    protected override async Task OnInitializedAsync()
    {
        await LoadDashboardData();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _timer = new System.Threading.Timer(async _ =>
            {
                await InvokeAsync(async () =>
                {
                    await LoadDashboardData();
                    StateHasChanged();
                    await RenderCharts();
                });
            }, null, 60000, 60000);
        }
        
        await RenderCharts();
    }

    private async Task RenderCharts()
    {
        if (Kpis == null) return;
        var labels = new[] { "Hace 5m", "Hace 4m", "Hace 3m", "Hace 2m", "Hace 1m", "Mes actual" };
        await JS.InvokeVoidAsync("renderFlowbiteAreaChart", "chart-activos", Kpis.TendenciaActivos, labels, null);
        await JS.InvokeVoidAsync("renderFlowbiteAreaChart", "chart-valor", Kpis.TendenciaValor, labels, "₡");
        
        var enVidaUtil = Kpis.TotalActivos - Kpis.ActivosDepreciados;
        await JS.InvokeVoidAsync("renderFlowbiteDonutChart", "donut-chart", new[] { Kpis.ActivosDepreciados, enVidaUtil }, new[] { "Depreciados", "En Vida Útil" });
    }

    private async Task ReloadManual()
    {
        isReloading = true;
        StateHasChanged();
        await LoadDashboardData();
        isReloading = false;
        StateHasChanged();
        await RenderCharts();
    }

    private async Task LoadDashboardData()
    {
        Kpis = await DashboardService.GetKPIsAsync();
        Alertas = await DashboardService.GetAlertasMantenimientoAsync();
        Actividades = await DashboardService.GetActividadRecienteAsync();
    }

    public void Dispose()
    {
        _timer?.Dispose();
    }
}