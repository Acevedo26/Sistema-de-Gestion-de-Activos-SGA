@page "/ubicaciones"
@using Sistema_de_Gestion_de_Activos.Domain.Entities
@using Sistema_de_Gestion_de_Activos.Application.Interfaces
@attribute [Authorize(Roles = "Administrador,Gestor")]
@inject IUbicacionService UbicacionService
@inject IAlertService AlertService

<PageTitle>Ubicaciones</PageTitle>

<div class="max-w-6xl mx-auto p-4 md:p-6">
    <div class="flex items-center gap-4 mb-6">
        <a href="/administracion" class="text-gray-400 hover:text-gray-600 dark:hover:text-gray-200">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg>
        </a>
        <div>
            <h1 class="text-2xl font-bold text-gray-900 dark:text-white">Ubicaciones</h1>
            <p class="text-sm text-gray-500 dark:text-gray-400">Gestione los edificios y oficinas.</p>
        </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <!-- Formulario (Crear/Editar) -->
        <div class="lg:col-span-1">
            <div class="bg-white dark:bg-gray-900 rounded-xl shadow-sm border border-gray-200 dark:border-gray-800 p-6 sticky top-6">
                <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-4">@(editingId.HasValue ? "Editar Ubicación" : "Nueva Ubicación")</h3>

                <EditForm Model="form" OnValidSubmit="Save" class="space-y-4">
                    <DataAnnotationsValidator />

                    <div>
                        <label class="block text-sm font-semibold text-gray-700 dark:text-gray-300 mb-1.5">Edificio <span class="text-red-500">*</span></label>
                        <InputText @bind-Value="form.Edificio" class="w-full rounded-lg border border-gray-300 dark:border-gray-700 bg-white dark:bg-gray-800 px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-primary-500/20 focus:border-primary-500 transition-colors" />
                    </div>

                    <div>
                        <label class="block text-sm font-semibold text-gray-700 dark:text-gray-300 mb-1.5">Departamento</label>
                        <InputText @bind-Value="form.Departamento" class="w-full rounded-lg border border-gray-300 dark:border-gray-700 bg-white dark:bg-gray-800 px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-primary-500/20 focus:border-primary-500 transition-colors" />
                    </div>

                    <div>
                        <label class="block text-sm font-semibold text-gray-700 dark:text-gray-300 mb-1.5">Oficina</label>
                        <InputText @bind-Value="form.Oficina" class="w-full rounded-lg border border-gray-300 dark:border-gray-700 bg-white dark:bg-gray-800 px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-primary-500/20 focus:border-primary-500 transition-colors" />
                    </div>

                    <div class="flex gap-2 pt-2">
                        @if (editingId.HasValue)
                        {
                            <button type="button" @onclick="CancelEdit" class="w-full rounded-lg border border-gray-300 dark:border-gray-700 bg-white dark:bg-gray-800 px-4 py-2.5 text-sm font-medium text-gray-700 dark:text-gray-300 hover:bg-gray-50 dark:hover:bg-gray-700 transition-colors">
                                Cancelar
                            </button>
                        }
                        <button type="submit" disabled="@isSubmitting" class="w-full rounded-lg bg-primary-600 px-4 py-2.5 text-sm font-medium text-white shadow-sm hover:bg-primary-700 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary-500 transition-colors disabled:opacity-50">
                            Guardar
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>

        <!-- Lista -->
        <div class="lg:col-span-2">
            <div class="bg-white dark:bg-gray-900 rounded-xl shadow-sm border border-gray-200 dark:border-gray-800 overflow-hidden">
                <div class="overflow-x-auto">
                    <table class="w-full text-left text-sm whitespace-nowrap">
                        <thead class="bg-gray-50 dark:bg-gray-800/50 text-gray-500 dark:text-gray-400">
                            <tr>
                                <th class="px-6 py-4 font-semibold border-b border-gray-200 dark:border-gray-700">Edificio</th>
                                <th class="px-6 py-4 font-semibold border-b border-gray-200 dark:border-gray-700">Departamento</th>
                                <th class="px-6 py-4 font-semibold border-b border-gray-200 dark:border-gray-700">Oficina</th>
                                <th class="px-6 py-4 font-semibold border-b border-gray-200 dark:border-gray-700 text-right">Acciones</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-gray-200 dark:divide-gray-800">
                            @if (ubicaciones == null)
                            {
                                <tr>
                                    <td colspan="4" class="px-6 py-8 text-center text-gray-500 dark:text-gray-400">Cargando...</td>
                                </tr>
                            }
                            else if (!ubicaciones.Any())
                            {
                                <tr>
                                    <td colspan="4" class="px-6 py-8 text-center text-gray-500 dark:text-gray-400">No hay ubicaciones registradas.</td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var ub in ubicaciones)
                                {
                                    <tr class="hover:bg-gray-50 dark:hover:bg-gray-800/50 transition-colors group">
                                        <td class="px-6 py-4 text-gray-900 dark:text-gray-100 font-medium">@ub.Edificio</td>
                                        <td class="px-6 py-4 text-gray-600 dark:text-gray-300">@ub.Departamento</td>
                                        <td class="px-6 py-4 text-gray-600 dark:text-gray-300">@ub.Oficina</td>
                                        <td class="px-6 py-4 text-right">
                                            <div class="flex justify-end gap-2 opacity-0 group-hover:opacity-100 transition-opacity">
                                                <button type="button" @onclick="() => Edit(ub)" class="p-2 text-gray-400 hover:text-primary-600 dark:hover:text-primary-400 bg-white dark:bg-gray-900 border border-gray-200 dark:border-gray-700 rounded-lg hover:border-primary-600 dark:hover:border-primary-400 transition-colors" title="Editar">
                                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg>
                                                </button>
                                                <button type="button" @onclick="() => Delete(ub)" class="p-2 text-gray-400 hover:text-red-600 dark:hover:text-red-400 bg-white dark:bg-gray-900 border border-gray-200 dark:border-gray-700 rounded-lg hover:border-red-600 dark:hover:border-red-400 transition-colors" title="Eliminar">
                                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M3 6h18"></path><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private List<Ubicacion> ubicaciones = new();
    private Ubicacion form = new();
    private Guid? editingId;
    private bool isSubmitting;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        ubicaciones = (await UbicacionService.ObtenerTodasAsync()).ToList();
    }

    private void Edit(Ubicacion ub)
    {
        editingId = ub.Id;
        form = new Ubicacion
        {
            Id = ub.Id,
            Edificio = ub.Edificio,
            Departamento = ub.Departamento,
            Oficina = ub.Oficina
        };
    }

    private void CancelEdit()
    {
        editingId = null;
        form = new Ubicacion();
    }

    private async Task Save()
    {
        if (string.IsNullOrWhiteSpace(form.Edificio))
        {
            await AlertService.ShowErrorAsync("Error", "El edificio es obligatorio.");
            return;
        }

        isSubmitting = true;
        try
        {
            if (editingId.HasValue)
            {
                await UbicacionService.ActualizarAsync(editingId.Value, form);
                await AlertService.ShowSuccessAsync("Éxito", "Ubicación actualizada.");
            }
            else
            {
                await UbicacionService.CrearAsync(form);
                await AlertService.ShowSuccessAsync("Éxito", "Ubicación creada.");
            }

            CancelEdit();
            await LoadData();
        }
        catch (Exception ex)
        {
            await AlertService.ShowErrorAsync("Error", ex.Message);
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private async Task Delete(Ubicacion ub)
    {
        var confirm = await AlertService.ConfirmAsync("Eliminar Ubicación", $"¿Desea eliminar la ubicación en {ub.Edificio}?");
        if (confirm)
        {
            try
            {
                var success = await UbicacionService.EliminarAsync(ub.Id);
                if (success)
                {
                    await AlertService.ShowSuccessAsync("Eliminada", "Ubicación eliminada correctamente.");
                    await LoadData();
                }
                else
                {
                    await AlertService.ShowErrorAsync("Error", "No se pudo eliminar.");
                }
            }
            catch (Exception)
            {
                await AlertService.ShowErrorAsync("Error", "No se puede eliminar la ubicación porque está en uso por activos.");
            }
        }
    }
}