@page "/activos"
@attribute [Authorize]
@using Sistema_de_Gestion_de_Activos.Application.DTOs.Activos
@using Sistema_de_Gestion_de_Activos.Application.DTOs.Depreciacion
@using Sistema_de_Gestion_de_Activos.Application.Interfaces
@using Sistema_de_Gestion_de_Activos.Domain.Enums
@inject IActivoService ActivoService
@inject ICategoriaService CategoriaService

<PageTitle>Activos</PageTitle>
<div class="mb-6 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between"><div><p class="text-sm font-medium text-primary-600">Inventario</p><h1 class="text-2xl font-bold tracking-tight">Gestión de activos</h1><p class="mt-1 text-sm text-gray-500">Controle el inventario tecnológico y su asignación.</p></div><button class="rounded-lg bg-primary-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm transition hover:bg-primary-700 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary-500" @onclick="OpenCreate">＋ Nuevo activo</button></div>

@if (!string.IsNullOrEmpty(message)) { <div class="mb-4 rounded-lg border px-4 py-3 text-sm @(isError ? "border-red-200 bg-red-50 text-red-800 dark:border-red-900 dark:bg-red-950/40 dark:text-red-200" : "border-green-200 bg-green-50 text-green-800 dark:border-green-900 dark:bg-green-950/40 dark:text-green-200")">@message</div> }

<section class="mb-5 grid grid-cols-1 gap-3 rounded-xl border border-gray-200 bg-white p-4 shadow-sm md:grid-cols-5 dark:border-gray-800 dark:bg-gray-900">
    <input @bind="search" @bind:event="oninput" @bind:after="ResetPage" placeholder="Código, descripción o serie" class="sga-input md:col-span-2" aria-label="Buscar activo" />
    <select @bind="categoryFilter" @bind:after="ResetPage" class="sga-input" aria-label="Filtrar por categoría"><option value="">Todas las categorías</option>@foreach (var category in categories) { <option value="@category.Id">@category.Nombre</option> }</select>
    <select @bind="stateFilter" @bind:after="ResetPage" class="sga-input" aria-label="Filtrar por estado"><option value="">Todos los estados</option>@foreach (var state in Enum.GetValues<EstadoActivo>()) { <option value="@state">@state</option> }</select>
    <input type="date" @bind="from" @bind:after="ResetPage" class="sga-input" aria-label="Adquisición desde" />
</section>

<section class="overflow-hidden rounded-xl border border-gray-200 bg-white shadow-sm dark:border-gray-800 dark:bg-gray-900">
    <div class="overflow-x-auto"><table class="w-full min-w-[850px] text-left text-sm"><thead class="bg-gray-50 text-xs uppercase tracking-wider text-gray-500 dark:bg-gray-800"><tr><th class="px-5 py-4"><button @onclick="() => SortBy(nameof(ActivoResponseDto.Codigo))">Código @SortMark(nameof(ActivoResponseDto.Codigo))</button></th><th class="px-5 py-4"><button @onclick="() => SortBy(nameof(ActivoResponseDto.Descripcion))">Descripción @SortMark(nameof(ActivoResponseDto.Descripcion))</button></th><th class="px-5 py-4">Categoría</th><th class="px-5 py-4">Estado</th><th class="px-5 py-4">Responsable</th><th class="px-5 py-4 text-right"><button @onclick="() => SortBy(nameof(ActivoResponseDto.CostoInicial))">Valor @SortMark(nameof(ActivoResponseDto.CostoInicial))</button></th><th class="px-5 py-4 text-right">Acciones</th></tr></thead>
    <tbody class="divide-y divide-gray-100 dark:divide-gray-800">@foreach (var asset in PagedAssets) { <tr class="transition hover:bg-primary-50/40 dark:hover:bg-primary-950/20"><td class="px-5 py-4 font-mono text-xs font-semibold text-primary-700 dark:text-primary-300">@asset.Codigo</td><td class="px-5 py-4"><span class="block font-medium">@asset.Descripcion</span><span class="block text-xs text-gray-500">@asset.NumeroSerie</span></td><td class="px-5 py-4">@CategoryName(asset.CategoriaId)</td><td class="px-5 py-4"><span class="rounded-full px-2.5 py-1 text-xs font-semibold @StateClass(asset.Estado)">@asset.Estado</span></td><td class="px-5 py-4">@(asset.ResponsableNombre ?? "Sin asignar")</td><td class="px-5 py-4 text-right font-medium">@asset.CostoInicial.ToString("C")</td><td class="px-5 py-4 text-right"><a href="/activos/@asset.Id/depreciacion" class="sga-icon-button" title="Ver detalle" aria-label="Ver detalle de @asset.Codigo"><svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg></a><button class="sga-icon-button" @onclick="() => OpenEdit(asset)" title="Editar" aria-label="Editar @asset.Codigo"><svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round"><path d="M17 3a2.828 2.828 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5L17 3z"></path></svg></button><button class="sga-icon-button text-red-600 hover:bg-red-50 dark:hover:bg-red-950/40" @onclick="() => confirmId = asset.Id" title="Dar de baja" aria-label="Dar de baja @asset.Codigo"><svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path><line x1="10" y1="11" x2="10" y2="17"></line><line x1="14" y1="11" x2="14" y2="17"></line></svg></button></td></tr> }
    @if (!FilteredAssets.Any()) { <tr><td colspan="7" class="px-5 py-12 text-center text-gray-500">No se encontraron activos con los filtros seleccionados.</td></tr> }</tbody></table></div>
    <div class="flex flex-wrap items-center justify-between gap-3 border-t border-gray-100 bg-gray-50 px-5 py-3 text-sm dark:border-gray-800 dark:bg-gray-800/50"><span class="text-gray-500">@FilteredAssets.Count() activos · Página @(page) de @TotalPages</span><div class="flex gap-1"><button class="sga-page" disabled="@(page == 1)" @onclick="() => page--">Anterior</button>@for (var i = 1; i <= TotalPages; i++) { var current = i; <button class="sga-page @(current == page ? "sga-page-active" : "")" @onclick="() => page = current">@current</button> }<button class="sga-page" disabled="@(page == TotalPages)" @onclick="() => page++">Siguiente</button></div></div>
</section>

<Modal @bind-IsOpen="showForm" Title="@(editing is null ? "Nuevo activo" : "Editar activo")" Class="max-w-2xl">
    <EditForm Model="form" OnValidSubmit="Save" class="grid grid-cols-1 gap-4 md:grid-cols-2"><DataAnnotationsValidator /><ValidationSummary />
        @if (editing is null) { <div><label class="sga-label">Código</label><InputText class="sga-input" @bind-Value="form.Codigo" /></div> }
        <div class="@(editing is null ? "" : "md:col-span-2")"><label class="sga-label">Descripción</label><InputText class="sga-input" @bind-Value="form.Descripcion" /></div>
        <div><label class="sga-label">Categoría</label><InputSelect class="sga-input" @bind-Value="form.CategoriaId"><option value="@Guid.Empty">Seleccione una categoría</option>@foreach (var category in categories) { <option value="@category.Id">@category.Nombre</option> }</InputSelect></div>
        <div><label class="sga-label">Ubicación (ID)</label><InputText class="sga-input" @bind-Value="locationText" placeholder="UUID de ubicación" /></div>
        <div><label class="sga-label">Valor de adquisición</label><InputNumber class="sga-input" @bind-Value="form.CostoInicial" /></div><div><label class="sga-label">Fecha de adquisición</label><InputDate class="sga-input" @bind-Value="form.FechaAdquisicion" /></div>
        <div><label class="sga-label">Proveedor</label><InputText class="sga-input" @bind-Value="form.Proveedor" /></div><div><label class="sga-label">Número de serie</label><InputText class="sga-input" @bind-Value="form.NumeroSerie" /></div>
        @if (editing is not null) { <div><label class="sga-label">Estado</label><InputSelect class="sga-input" @bind-Value="editState">@foreach (var state in Enum.GetValues<EstadoActivo>()) { <option value="@state">@state</option> }</InputSelect></div> }
        <div class="flex justify-end gap-2 md:col-span-2"><button type="button" class="rounded-lg px-4 py-2 text-sm font-semibold hover:bg-gray-100 dark:hover:bg-gray-800" @onclick="() => showForm = false">Cancelar</button><button type="submit" class="rounded-lg bg-primary-600 px-4 py-2 text-sm font-semibold text-white hover:bg-primary-700">Guardar</button></div>
    </EditForm>
</Modal>
<Modal @bind-IsOpen="showConfirm" Title="Confirmar baja"><p class="text-sm text-gray-600 dark:text-gray-300">El activo se desactivará y dejará de estar disponible para nuevas asignaciones.</p><div class="mt-6 flex justify-end gap-2"><button class="rounded-lg px-4 py-2 text-sm font-semibold hover:bg-gray-100 dark:hover:bg-gray-800" @onclick="() => confirmId = null">Cancelar</button><button class="rounded-lg bg-red-600 px-4 py-2 text-sm font-semibold text-white hover:bg-red-700" @onclick="Deactivate">Dar de baja</button></div></Modal>

@code {
    private readonly List<ActivoResponseDto> assets = new(); private List<CategoriaResponseDto> categories = new(); private ActivoRequestDto form = new() { FechaAdquisicion = DateTime.Today }; private ActivoResponseDto? editing;
    private string search = "", categoryFilter = "", stateFilter = "", locationText = "", sort = nameof(ActivoResponseDto.Codigo), message = ""; private DateTime? from; private EstadoActivo editState; private int page = 1; private bool descending, showForm, isError; private Guid? confirmId;
    private bool showConfirm { get => confirmId.HasValue; set { if (!value) confirmId = null; } }
    protected override async Task OnInitializedAsync() { categories = (await CategoriaService.ObtenerTodasAsync()).ToList(); await Load(); }
    private async Task Load() { assets.Clear(); assets.AddRange(await ActivoService.ObtenerTodosAsync()); ResetPage(); }
    private IEnumerable<ActivoResponseDto> FilteredAssets => Sort(assets.Where(x => (string.IsNullOrWhiteSpace(search) || x.Codigo.Contains(search, StringComparison.OrdinalIgnoreCase) || x.Descripcion.Contains(search, StringComparison.OrdinalIgnoreCase) || (x.NumeroSerie?.Contains(search, StringComparison.OrdinalIgnoreCase) ?? false)) && (string.IsNullOrEmpty(categoryFilter) || x.CategoriaId.ToString() == categoryFilter) && (string.IsNullOrEmpty(stateFilter) || x.Estado.ToString() == stateFilter) && (!from.HasValue || x.FechaAdquisicion.Date >= from.Value.Date)));
    private IEnumerable<ActivoResponseDto> PagedAssets => FilteredAssets.Skip((page - 1) * 5).Take(5);
    private int TotalPages => Math.Max(1, (int)Math.Ceiling(FilteredAssets.Count() / 5d));
    private IEnumerable<ActivoResponseDto> Sort(IEnumerable<ActivoResponseDto> query) => sort switch { nameof(ActivoResponseDto.Descripcion) => descending ? query.OrderByDescending(x => x.Descripcion) : query.OrderBy(x => x.Descripcion), nameof(ActivoResponseDto.CostoInicial) => descending ? query.OrderByDescending(x => x.CostoInicial) : query.OrderBy(x => x.CostoInicial), _ => descending ? query.OrderByDescending(x => x.Codigo) : query.OrderBy(x => x.Codigo) };
    private void SortBy(string column) { if (sort == column) descending = !descending; else { sort = column; descending = false; } ResetPage(); }
    private string SortMark(string column) => sort == column ? (descending ? "↓" : "↑") : "";
    private void ResetPage() => page = 1;
    private string CategoryName(Guid id) => categories.FirstOrDefault(x => x.Id == id)?.Nombre ?? "—";
    private static string StateClass(EstadoActivo state) => state == EstadoActivo.Activo ? "bg-green-100 text-green-700 dark:bg-green-950/50 dark:text-green-300" : "bg-gray-200 text-gray-700 dark:bg-gray-700 dark:text-gray-300";
    private void OpenCreate() { editing = null; form = new() { FechaAdquisicion = DateTime.Today }; locationText = ""; showForm = true; }
    private void OpenEdit(ActivoResponseDto asset) { editing = asset; form = new() { Codigo = asset.Codigo, Descripcion = asset.Descripcion, CategoriaId = asset.CategoriaId, UbicacionId = asset.UbicacionId, CostoInicial = asset.CostoInicial, FechaAdquisicion = asset.FechaAdquisicion, Proveedor = asset.Proveedor, NumeroSerie = asset.NumeroSerie }; locationText = asset.UbicacionId.ToString(); editState = asset.Estado; showForm = true; }
    private async Task Save() { try { if (!Guid.TryParse(locationText, out var location)) throw new InvalidOperationException("Seleccione una ubicación válida."); form.UbicacionId = location; if (form.CategoriaId == Guid.Empty) throw new InvalidOperationException("Seleccione una categoría."); if (editing is null) await ActivoService.CrearActivoAsync(form); else await ActivoService.ActualizarActivoAsync(editing.Id, new ActivoUpdateDto { Descripcion = form.Descripcion, CategoriaId = form.CategoriaId, UbicacionId = location, CostoInicial = form.CostoInicial, FechaAdquisicion = form.FechaAdquisicion, Proveedor = form.Proveedor, NumeroSerie = form.NumeroSerie, Estado = editState }); showForm = false; isError = false; message = "Activo guardado correctamente."; await Load(); } catch (Exception ex) { isError = true; message = ex.Message; } }
    private async Task Deactivate() { if (!confirmId.HasValue) return; try { await ActivoService.DesactivarActivoAsync(confirmId.Value); message = "Activo dado de baja."; isError = false; await Load(); } catch (Exception ex) { message = ex.Message; isError = true; } finally { confirmId = null; } }
}
