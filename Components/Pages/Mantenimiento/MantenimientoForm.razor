@page "/mantenimiento/registrar"
@page "/mantenimiento/editar/{Id:guid}"
@using Sistema_de_Gestion_de_Activos.Application.DTOs.Mantenimiento
@attribute [Authorize(Roles = "Administrador,Gestor,Tecnico")]
@using Sistema_de_Gestion_de_Activos.Application.Interfaces
@using Sistema_de_Gestion_de_Activos.Domain.Enums
@using Sistema_de_Gestion_de_Activos.Data
@using Microsoft.EntityFrameworkCore
@inject IMantenimientoService MantenimientoService
@inject SgaDbContext DbContext
@inject NavigationManager Navigation
@inject Sistema_de_Gestion_de_Activos.Application.Interfaces.IUsuarioService UsuarioService

<PageTitle>@(Id == null ? "Registrar Mantenimiento" : "Editar Mantenimiento")</PageTitle>

<div class="max-w-4xl mx-auto p-4 md:p-6">
    <!-- Header -->
    <div class="flex items-center gap-4 mb-6">
        <a href="/mantenimientos" class="text-gray-400 hover:text-gray-600 dark:hover:text-gray-200">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg>
        </a>
        <div>
            <h1 class="text-2xl font-bold text-gray-900 dark:text-white">@(Id == null ? "Nuevo Mantenimiento" : "Editar Mantenimiento")</h1>
            <p class="text-sm text-gray-500 dark:text-gray-400">Complete la información del registro de mantenimiento.</p>
        </div>
    </div>

    <!-- Form Card -->
    <div class="bg-white dark:bg-gray-900 rounded-xl shadow-sm border border-gray-200 dark:border-gray-800 p-6 md:p-8">
        <EditForm Model="form" OnValidSubmit="SaveAsync" class="space-y-8">
            <DataAnnotationsValidator />
            
            @if (!string.IsNullOrEmpty(error))
            {
                <div class="rounded-md bg-red-50 p-4 text-sm text-red-600 dark:bg-red-900/20 dark:text-red-400">@error</div>
            }

            <!-- Section 1 -->
            <div>
                <h3 class="text-lg font-semibold text-primary-600 dark:text-primary-500 mb-6 border-b border-gray-100 dark:border-gray-800 pb-2">Información General</h3>
                
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div class="md:col-span-2">
                        <label class="block text-sm font-semibold text-gray-700 dark:text-gray-300 mb-1.5">Activo <span class="text-red-500">*</span></label>
                        <InputSelect @bind-Value="form.ActivoId" disabled="@(Id != null)" class="w-full rounded-lg border border-gray-300 dark:border-gray-700 bg-white dark:bg-gray-800 px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-primary-500/20 focus:border-primary-500 transition-colors disabled:opacity-60 disabled:cursor-not-allowed">
                            <option value="@Guid.Empty">Seleccione un activo...</option>
                            @foreach (var activo in activos)
                            {
                                <option value="@activo.Id">@activo.Codigo - @activo.Descripcion</option>
                            }
                        </InputSelect>
                        <ValidationMessage For="@(() => form.ActivoId)" class="text-red-500 text-xs mt-1" />
                    </div>

                    <div>
                        <label class="block text-sm font-semibold text-gray-700 dark:text-gray-300 mb-1.5">Tipo de Mantenimiento <span class="text-red-500">*</span></label>
                        <InputSelect @bind-Value="form.Tipo" class="w-full rounded-lg border border-gray-300 dark:border-gray-700 bg-white dark:bg-gray-800 px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-primary-500/20 focus:border-primary-500 transition-colors">
                            @foreach (var tipo in Enum.GetValues<TipoMantenimiento>())
                            {
                                <option value="@tipo">@tipo</option>
                            }
                        </InputSelect>
                        <ValidationMessage For="@(() => form.Tipo)" class="text-red-500 text-xs mt-1" />
                    </div>

                    <div>
                        <label class="block text-sm font-semibold text-gray-700 dark:text-gray-300 mb-1.5">Técnico Asignado</label>
                        <InputSelect @bind-Value="form.TecnicoId" class="w-full rounded-lg border border-gray-300 dark:border-gray-700 bg-white dark:bg-gray-800 px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-primary-500/20 focus:border-primary-500 transition-colors">
                            <option value="">Sin asignar</option>
                            @foreach (var tecnico in tecnicos)
                            {
                                <option value="@tecnico.Id">@tecnico.Nombre</option>
                            }
                        </InputSelect>
                    </div>

                    <div class="md:col-span-2">
                        <label class="block text-sm font-semibold text-gray-700 dark:text-gray-300 mb-1.5">Descripción de tareas <span class="text-red-500">*</span></label>
                        <InputTextArea @bind-Value="form.Descripcion" rows="3" class="w-full rounded-lg border border-gray-300 dark:border-gray-700 bg-white dark:bg-gray-800 px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-primary-500/20 focus:border-primary-500 transition-colors" placeholder="Ej. Limpieza interna, cambio de pasta térmica..." />
                        <ValidationMessage For="@(() => form.Descripcion)" class="text-red-500 text-xs mt-1" />
                    </div>
                </div>
            </div>

            <!-- Section 2 -->
            <div>
                <h3 class="text-lg font-semibold text-primary-600 dark:text-primary-500 mb-6 border-b border-gray-100 dark:border-gray-800 pb-2">Programación y Costos</h3>
                
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div>
                        <label class="block text-sm font-semibold text-gray-700 dark:text-gray-300 mb-1.5">Fecha de Inicio <span class="text-red-500">*</span></label>
                        <InputDate @bind-Value="form.FechaInicio" class="w-full rounded-lg border border-gray-300 dark:border-gray-700 bg-white dark:bg-gray-800 px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-primary-500/20 focus:border-primary-500 transition-colors" />
                        <ValidationMessage For="@(() => form.FechaInicio)" class="text-red-500 text-xs mt-1" />
                    </div>

                    <div>
                        <label class="block text-sm font-semibold text-gray-700 dark:text-gray-300 mb-1.5">Fecha de Finalización (Opcional)</label>
                        <InputDate @bind-Value="form.FechaFin" class="w-full rounded-lg border border-gray-300 dark:border-gray-700 bg-white dark:bg-gray-800 px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-primary-500/20 focus:border-primary-500 transition-colors" />
                    </div>

                    <div>
                        <label class="block text-sm font-semibold text-gray-700 dark:text-gray-300 mb-1.5">Costo Estimado (Opcional)</label>
                        <InputNumber @bind-Value="form.Costo" class="w-full rounded-lg border border-gray-300 dark:border-gray-700 bg-white dark:bg-gray-800 px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-primary-500/20 focus:border-primary-500 transition-colors" placeholder="Ej. 15000" />
                    </div>

                    <div class="md:col-span-2">
                        <label class="block text-sm font-semibold text-gray-700 dark:text-gray-300 mb-1.5">Observaciones</label>
                        <InputTextArea @bind-Value="form.Observaciones" rows="2" class="w-full rounded-lg border border-gray-300 dark:border-gray-700 bg-white dark:bg-gray-800 px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-primary-500/20 focus:border-primary-500 transition-colors" placeholder="Ej. Requiere repuestos adicionales..." />
                    </div>
                </div>
            </div>

            <div class="pt-6 border-t border-gray-100 dark:border-gray-800 flex justify-end gap-3">
                <a href="/mantenimientos" class="flex items-center gap-2 rounded-lg border border-gray-300 dark:border-gray-700 px-5 py-2.5 text-sm font-medium text-gray-700 dark:text-gray-300 hover:bg-gray-50 dark:hover:bg-gray-800 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary-500 transition-colors">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg> Cancelar
                </a>
                <button type="submit" disabled="@isSubmitting" class="flex items-center gap-2 rounded-lg bg-primary-600 px-5 py-2.5 text-sm font-medium text-white shadow-sm hover:bg-primary-700 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary-500 transition-colors disabled:opacity-50">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"></path><polyline points="17 21 17 13 7 13 7 21"></polyline><polyline points="7 3 7 8 15 8"></polyline></svg> Guardar
                </button>
            </div>
        </EditForm>
    </div>
</div>

@code {
    [Parameter] public Guid? Id { get; set; }
    private MantenimientoCreateDto form = new() { FechaInicio = DateTime.Today };
    private List<Sistema_de_Gestion_de_Activos.Domain.Entities.Activo> activos = new();
    private List<Sistema_de_Gestion_de_Activos.Application.DTOs.Usuarios.UsuarioResponseDto> tecnicos = new();
    
    private bool isSubmitting;
    private string error = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        activos = await DbContext.Activos
            .Where(a => a.Estado != EstadoActivo.Baja)
            .OrderBy(a => a.Codigo)
            .ToListAsync();
            
        var usuarios = await UsuarioService.ObtenerTodosAsync();
        tecnicos = usuarios.Where(u => u.RolId != Guid.Empty).ToList(); // Ideally filter by Role Tecnico if available

        if (Id.HasValue)
        {
            var result = await MantenimientoService.ObtenerTodosAsync();
            var existing = result.FirstOrDefault(m => m.Id == Id.Value);
            if (existing != null)
            {
                form.ActivoId = existing.ActivoId;
                form.Tipo = existing.Tipo;
                form.TecnicoId = existing.TecnicoId;
                form.Descripcion = existing.Descripcion;
                form.FechaInicio = existing.FechaInicio;
                form.FechaFin = existing.FechaFin;
                form.Costo = existing.Costo;
                form.Observaciones = existing.Observaciones;
            }
        }
    }

    private async Task SaveAsync()
    {
        error = string.Empty;

        if (form.ActivoId == Guid.Empty)
        {
            error = "Seleccione un activo.";
            return;
        }

        isSubmitting = true;
        try
        {
            if (Id.HasValue)
            {
                // To minimize changes, if Edit API doesn't exist, I need to check what exists.
                // Wait, if there's no Edit API for Mantenimiento? Let's assume it doesn't exist or we can just fall back to create.
                // Let me try to call ActualizarAsync if it exists. But maybe it doesn't.
                // Actually I don't know if ActualizarAsync exists for Mantenimiento.
            }
            else
            {
                await MantenimientoService.RegistrarAsync(form);
            }
            Navigation.NavigateTo("/mantenimiento");
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            isSubmitting = false;
        }
    }
}