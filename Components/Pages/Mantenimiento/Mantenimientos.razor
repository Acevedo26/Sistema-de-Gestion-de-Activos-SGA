@page "/mantenimientos"
@attribute [Authorize]
@using Sistema_de_Gestion_de_Activos.Application.DTOs.Mantenimiento
@using Sistema_de_Gestion_de_Activos.Application.Interfaces
@using Sistema_de_Gestion_de_Activos.Domain.Enums
@inject IMantenimientoService MantenimientoService
@inject NavigationManager Navigation
@inject IAlertService AlertService

<PageTitle>Mantenimiento de Activos</PageTitle>

<!-- Header -->
<div class="mb-6">
    <h1 class="text-2xl font-bold text-gray-900 dark:text-white">Mantenimiento de Activos</h1>
</div>

<!-- Filters Bar -->
<div class="mb-6 rounded-xl border border-gray-200 bg-white p-4 shadow-sm dark:border-gray-800 dark:bg-gray-900">
    <div class="flex flex-col sm:flex-row gap-4">
        <!-- Búsqueda -->
        <div class="relative flex-1">
            <span class="absolute inset-y-0 left-0 flex items-center pl-3 text-gray-400">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
            </span>
            <input type="text" placeholder="Buscar por activo, técnico, descripción..." class="w-full rounded-lg border border-gray-200 bg-gray-50 py-2 pl-10 pr-4 text-sm focus:border-primary-500 focus:ring-1 focus:ring-primary-500 dark:border-gray-700 dark:bg-gray-800 dark:text-white" @bind="search" @bind:event="oninput" @bind:after="ResetPage" />
        </div>
        
        <!-- Botón Filtros -->
        <button class="flex items-center gap-2 rounded-lg border border-gray-200 bg-white px-4 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50 dark:border-gray-700 dark:bg-gray-800 dark:text-gray-200 dark:hover:bg-gray-700" @onclick="() => showFilters = !showFilters">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"></polygon></svg> Filtros
        </button>
        
        <!-- Descargar -->
        <button class="flex items-center gap-2 rounded-lg border border-gray-200 bg-white px-4 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50 dark:border-gray-700 dark:bg-gray-800 dark:text-gray-200 dark:hover:bg-gray-700">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg> Descargar
        </button>
    </div>
    
    @if (showFilters) {
        <div class="mt-4 grid grid-cols-1 gap-4 border-t border-gray-100 pt-4 sm:grid-cols-2 dark:border-gray-800">
            <select @bind="tipoFiltro" @bind:after="ResetPage" class="w-full rounded-lg border border-gray-200 bg-gray-50 py-2 px-3 text-sm focus:border-primary-500 focus:ring-1 focus:ring-primary-500 dark:border-gray-700 dark:bg-gray-800 dark:text-white" aria-label="Filtrar por tipo">
                <option value="">Todos los tipos</option>
                @foreach (var tipo in Enum.GetValues<TipoMantenimiento>()) { <option value="@tipo">@tipo</option> }
            </select>
            <select @bind="estadoFiltro" @bind:after="ResetPage" class="w-full rounded-lg border border-gray-200 bg-gray-50 py-2 px-3 text-sm focus:border-primary-500 focus:ring-1 focus:ring-primary-500 dark:border-gray-700 dark:bg-gray-800 dark:text-white" aria-label="Filtrar por estado">
                <option value="">Todos los estados</option>
                @foreach (var estado in Enum.GetValues<EstadoMantenimiento>()) { <option value="@estado">@estado</option> }
            </select>
        </div>
    }
</div>

<!-- Data Table -->
<div class="overflow-hidden rounded-xl border border-gray-200 bg-white shadow-sm dark:border-gray-800 dark:bg-gray-900">
    <div class="overflow-x-auto min-h-[300px]">
        <table class="w-full text-left text-sm">
            <thead class="border-b border-gray-200 bg-white text-gray-500 dark:border-gray-800 dark:bg-gray-900">
                <tr>
                    <th class="px-6 py-4 font-medium"><input type="checkbox" class="rounded border-gray-300 text-primary-600 focus:ring-primary-500 dark:border-gray-700 dark:bg-gray-800" /></th>
                    <th class="px-6 py-4 font-medium">Activo</th>
                    <th class="px-6 py-4 font-medium">Tipo</th>
                    <th class="px-6 py-4 font-medium">Técnico</th>
                    <th class="px-6 py-4 font-medium">Fecha Inicio</th>
                    <th class="px-6 py-4 font-medium">Fecha Fin</th>
                    <th class="px-6 py-4 font-medium text-right">Costo</th>
                    <th class="px-6 py-4 font-medium">Estado</th>
                    <th class="px-6 py-4 font-medium text-right"></th>
                </tr>
            </thead>
            <tbody class="divide-y divide-gray-100 dark:divide-gray-800">
                @if (mantenimientos != null)
                {
                    @foreach (var m in Filtrados.Skip((page - 1) * 5).Take(5))
                    {
                        <tr class="transition hover:bg-gray-50 dark:hover:bg-gray-800/50">
                            <td class="px-6 py-4"><input type="checkbox" class="rounded border-gray-300 text-primary-600 focus:ring-primary-500 dark:border-gray-700 dark:bg-gray-800" /></td>
                            <td class="px-6 py-4 font-medium text-gray-900 dark:text-white">@m.ActivoDescripcion</td>
                            <td class="px-6 py-4">
                                <span class="inline-flex items-center gap-1.5 rounded-full border border-gray-200 px-2.5 py-1 text-xs font-medium text-gray-700 bg-white dark:border-gray-700 dark:bg-gray-800 dark:text-gray-300">
                                    <span class="h-1.5 w-1.5 rounded-full @TipoDotColor(m.Tipo)"></span> @m.Tipo
                                </span>
                            </td>
                            <td class="px-6 py-4 text-gray-700 dark:text-gray-300">@m.TecnicoNombre</td>
                            <td class="px-6 py-4 text-gray-500 dark:text-gray-400">@m.FechaInicio.ToString("dd/MM/yyyy")</td>
                            <td class="px-6 py-4 text-gray-500 dark:text-gray-400">@(m.FechaFin.HasValue ? m.FechaFin.Value.ToString("dd/MM/yyyy") : "—")</td>
                            <td class="px-6 py-4 text-right font-medium text-gray-900 dark:text-white">@m.Costo.ToString("C")</td>
                            <td class="px-6 py-4">
                                <span class="inline-flex items-center gap-1.5 rounded-full border border-gray-200 px-2.5 py-1 text-xs font-medium text-gray-700 bg-white dark:border-gray-700 dark:bg-gray-800 dark:text-gray-300">
                                    <span class="h-1.5 w-1.5 rounded-full @EstadoDotColor(m.Estado)"></span> @m.Estado
                                </span>
                            </td>
                            <td class="px-6 py-4 text-right relative">
                                <div class="flex items-center justify-end gap-2">
                                    <button class="text-gray-400 hover:text-gray-600 dark:hover:text-gray-300" @onclick="() => ToggleMenu(m.Id)"><svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><circle cx="12" cy="12" r="1"></circle><circle cx="12" cy="5" r="1"></circle><circle cx="12" cy="19" r="1"></circle></svg></button>
                                </div>
                                @if (openMenuId == m.Id) {
                                    <div class="absolute right-0 top-full mt-1 z-50 w-36 rounded-md bg-white py-1 shadow-lg ring-1 ring-black ring-opacity-5 dark:bg-gray-800 dark:ring-gray-700 text-left">
                                        <!-- Note: missing direct route to View Detail, but let's mock the list -->
                                        
                                        <a href="/mantenimiento/editar/@m.Id" class="block w-full text-left px-4 py-2 text-sm text-gray-700 hover:bg-gray-100 dark:text-gray-200 dark:hover:bg-gray-700" @onclick="() => ToggleMenu(null)">Editar</a>
                                        @if (m.Estado != EstadoMantenimiento.Finalizado)
                                        {
                                            <button class="block w-full text-left px-4 py-2 text-sm text-green-600 hover:bg-gray-100 dark:hover:bg-gray-700" @onclick="() => { IrAFinalizar(m.Id); ToggleMenu(null); }">Finalizar</button>
                                        }
                                        <button class="block w-full text-left px-4 py-2 text-sm text-red-600 hover:bg-gray-100 dark:hover:bg-gray-700" @onclick="() => EliminarPrompt(m.Id)">Eliminar</button>
                                    </div>
                                }
                            </td>
                        </tr>
                    }
                    @if (!mantenimientos.Any())
                    {
                        <tr>
                            <td colspan="9" class="px-6 py-12 text-center text-gray-500">
                                No hay mantenimientos registrados todavía.
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <!-- Paginación -->
    <div class="flex items-center justify-between border-t border-gray-100 bg-white px-6 py-4 dark:border-gray-800 dark:bg-gray-900">
        <div class="text-sm text-gray-500">
            Mostrando @(((page - 1) * 5) + (Filtrados.Any() ? 1 : 0)) a @Math.Min(page * 5, Filtrados.Count()) de @Filtrados.Count() resultados
        </div>
        <div class="flex items-center gap-1">
            <button class="rounded border border-gray-200 px-2.5 py-1 text-gray-500 hover:bg-gray-50 disabled:opacity-50 dark:border-gray-700 dark:text-gray-400 dark:hover:bg-gray-800" disabled="@(page == 1)" @onclick="() => page--">&lt;</button>
            @for (var i = 1; i <= TotalPages; i++) {
                var current = i;
                <button class="@(current == page ? "rounded bg-primary-600 px-3 py-1 text-white" : "rounded border border-gray-200 px-3 py-1 text-gray-500 hover:bg-gray-50 dark:border-gray-700 dark:text-gray-400 dark:hover:bg-gray-800")" @onclick="() => page = current">@current</button>
            }
            <button class="rounded border border-gray-200 px-2.5 py-1 text-gray-500 hover:bg-gray-50 disabled:opacity-50 dark:border-gray-700 dark:text-gray-400 dark:hover:bg-gray-800" disabled="@(page == TotalPages)" @onclick="() => page++">&gt;</button>
        </div>
    </div>
</div>

<!-- Botón Crear (Abajo derecha) -->
<div class="mt-6 flex justify-between items-center">
    <a href="/mantenimiento/programas" class="text-sm font-medium text-primary-600 hover:text-primary-700">
        Ver programas de mantenimiento preventivo →
    </a>
    <button class="flex items-center gap-2 rounded-full bg-primary-600 px-5 py-2.5 text-sm font-medium text-white shadow-sm hover:bg-primary-700 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary-500 transition-colors" @onclick="IrARegistrar">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg> Nuevo Mantenimiento
    </button>
</div>



@code {
    private List<MantenimientoResponseDto>? mantenimientos;
    private string search = "", tipoFiltro = "", estadoFiltro = "";
    private int page = 1;
    private bool showFilters = false;
    private Guid? openMenuId;
        
    private IEnumerable<MantenimientoResponseDto> Filtrados => (mantenimientos ?? Enumerable.Empty<MantenimientoResponseDto>()).Where(m =>
        (string.IsNullOrWhiteSpace(search) || m.ActivoDescripcion.Contains(search, StringComparison.OrdinalIgnoreCase) || m.TecnicoNombre.Contains(search, StringComparison.OrdinalIgnoreCase) || m.Descripcion.Contains(search, StringComparison.OrdinalIgnoreCase)) &&
        (string.IsNullOrEmpty(tipoFiltro) || m.Tipo.ToString() == tipoFiltro) &&
        (string.IsNullOrEmpty(estadoFiltro) || m.Estado.ToString() == estadoFiltro));
    private int TotalPages => Math.Max(1, (int)Math.Ceiling(Filtrados.Count() / 5d));

    protected override async Task OnInitializedAsync()
    {
        mantenimientos = (await MantenimientoService.ObtenerTodosAsync()).ToList();
    }

    private void ToggleMenu(Guid? id) {
        if (openMenuId == id) openMenuId = null;
        else openMenuId = id;
    }

    private void IrARegistrar() => Navigation.NavigateTo("/mantenimiento/registrar");

    private void ResetPage() => page = 1;
    private async Task EliminarPrompt(Guid id)
    {
        var confirmed = await AlertService.ConfirmAsync(
            "Confirmar eliminación",
            "¿Está seguro que desea eliminar este registro de mantenimiento? Esta acción no se puede deshacer."
        );
        if (confirmed)
        {
            await MantenimientoService.EliminarAsync(id);
            await AlertService.ShowSuccessAsync("Eliminado", "El mantenimiento ha sido eliminado.");
            mantenimientos = (await MantenimientoService.ObtenerTodosAsync()).ToList();
        }
    }

    private void IrAFinalizar(Guid id) => Navigation.NavigateTo($"/mantenimiento/finalizar/{id}");

    private string EstadoDotColor(EstadoMantenimiento estado) => estado switch
    {
        EstadoMantenimiento.Finalizado => "bg-green-500",
        EstadoMantenimiento.EnProgreso => "bg-amber-500",
        EstadoMantenimiento.Pendiente => "bg-blue-500",
        _ => "bg-gray-500"
    };

    private string TipoDotColor(TipoMantenimiento tipo) => tipo switch
    {
        TipoMantenimiento.Preventivo => "bg-blue-500",
        TipoMantenimiento.Correctivo => "bg-red-500",
        _ => "bg-primary-500"
    };
}
