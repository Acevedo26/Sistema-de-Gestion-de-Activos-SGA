@page "/mantenimiento"
@page "/mantenimientos"
@using Sistema_de_Gestion_de_Activos.Application.DTOs.Mantenimiento
@attribute [Authorize(Roles = "Administrador,Gestor,Tecnico")]
@using Sistema_de_Gestion_de_Activos.Application.Interfaces
@using Sistema_de_Gestion_de_Activos.Domain.Enums
@inject IMantenimientoService MantenimientoService
@inject NavigationManager Navigation

<PageTitle>Mantenimiento de Activos</PageTitle>

<div class="flex justify-between items-center mb-6">
    <h4 class="text-xl font-bold text-gray-900 dark:text-white mb-0">Mantenimiento de Activos</h4>
    <button class="inline-flex items-center gap-2 px-4 py-2 text-sm font-medium text-white bg-primary-600 rounded-md hover:bg-primary-700 transition-colors"
            @onclick="IrARegistrar">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
        Nuevo Mantenimiento
    </button>
</div>

<div class="mb-5 grid grid-cols-1 gap-3 rounded-xl border border-gray-200 bg-white p-4 shadow-sm md:grid-cols-3 dark:border-gray-700 dark:bg-gray-800">
    <input @bind="search" @bind:event="oninput" @bind:after="ResetPage" placeholder="Activo, técnico o descripción" class="rounded-lg border border-gray-300 bg-transparent px-3 py-2 text-sm outline-none focus:border-primary-500 focus:ring-2 focus:ring-primary-100 dark:border-gray-600" aria-label="Buscar mantenimiento" />
    <select @bind="tipoFiltro" @bind:after="ResetPage" class="rounded-lg border border-gray-300 bg-transparent px-3 py-2 text-sm outline-none focus:border-primary-500 focus:ring-2 focus:ring-primary-100 dark:border-gray-600" aria-label="Filtrar por tipo"><option value="">Todos los tipos</option>@foreach (var tipo in Enum.GetValues<TipoMantenimiento>()) { <option value="@tipo">@tipo</option> }</select>
    <select @bind="estadoFiltro" @bind:after="ResetPage" class="rounded-lg border border-gray-300 bg-transparent px-3 py-2 text-sm outline-none focus:border-primary-500 focus:ring-2 focus:ring-primary-100 dark:border-gray-600" aria-label="Filtrar por estado"><option value="">Todos los estados</option>@foreach (var estado in Enum.GetValues<EstadoMantenimiento>()) { <option value="@estado">@estado</option> }</select>
</div>

<div class="bg-white dark:bg-gray-800 rounded-xl shadow-sm border border-gray-200 dark:border-gray-700 overflow-hidden mb-6">
    <div class="overflow-x-auto">
        <table class="w-full text-left text-sm text-gray-600 dark:text-gray-300 align-middle">
            <thead class="bg-gray-50 dark:bg-gray-700/50 text-gray-700 dark:text-gray-200 font-semibold text-xs uppercase tracking-wider border-b border-gray-200 dark:border-gray-700">
                <tr>
                    <th class="px-6 py-4">Activo</th>
                    <th class="px-6 py-4">Técnico</th>
                    <th class="px-6 py-4">Tipo</th>
                    <th class="px-6 py-4">Estado</th>
                    <th class="px-6 py-4">Fecha Inicio</th>
                    <th class="px-6 py-4">Fecha Fin</th>
                    <th class="px-6 py-4">Costo</th>
                    <th class="px-6 py-4 text-right">Acciones</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-gray-200 dark:divide-gray-700">
                @if (mantenimientos != null)
                {
                    @foreach (var m in Filtrados.Skip((page - 1) * 5).Take(5))
                    {
                        <tr class="hover:bg-gray-50 dark:hover:bg-gray-700/50 transition-colors">
                            <td class="px-6 py-4 font-medium text-gray-900 dark:text-white">@m.ActivoDescripcion</td>
                            <td class="px-6 py-4">@m.TecnicoNombre</td>
                            <td class="px-6 py-4">@m.Tipo</td>
                            <td class="px-6 py-4">
                                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium @EstadoBadgeClass(m.Estado)">
                                    @m.Estado
                                </span>
                            </td>
                            <td class="px-6 py-4">@m.FechaInicio.ToString("dd/MM/yyyy")</td>
                            <td class="px-6 py-4">@(m.FechaFin.HasValue ? m.FechaFin.Value.ToString("dd/MM/yyyy") : "—")</td>
                            <td class="px-6 py-4">₡@m.Costo.ToString("N2")</td>
                            <td class="px-6 py-4 text-right">
                                @if (m.Estado != EstadoMantenimiento.Finalizado)
                                {
                                    <button class="inline-grid h-8 w-8 place-items-center rounded-md bg-green-600 text-sm font-bold text-white transition hover:bg-green-700 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-green-500" @onclick="() => IrAFinalizar(m.Id)" title="Finalizar mantenimiento" aria-label="Finalizar mantenimiento"><svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg></button>
                                }
                            </td>
                        </tr>
                    }
                    @if (!mantenimientos.Any())
                    {
                        <tr>
                            <td colspan="8" class="px-6 py-8 text-center text-gray-400">
                                No hay mantenimientos registrados todavía.
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<div class="mb-6 flex items-center justify-between text-sm"><span class="text-gray-500">@Filtrados.Count() registros · Página @(page) de @TotalPages</span><div class="flex gap-1"><button class="rounded px-3 py-1 hover:bg-gray-100 disabled:opacity-40 dark:hover:bg-gray-800" disabled="@(page == 1)" @onclick="() => page--">Anterior</button>@for (var i = 1; i <= TotalPages; i++) { var current = i; <button class="rounded px-3 py-1 @(current == page ? "bg-primary-600 text-white" : "hover:bg-gray-100 dark:hover:bg-gray-800")" @onclick="() => page = current">@current</button> }<button class="rounded px-3 py-1 hover:bg-gray-100 disabled:opacity-40 dark:hover:bg-gray-800" disabled="@(page == TotalPages)" @onclick="() => page++">Siguiente</button></div></div>

<div class="flex justify-end">
    <a href="/mantenimiento/programas" class="text-sm font-medium text-primary-600 hover:text-primary-700">
        Ver programas de mantenimiento preventivo →
    </a>
</div>

@code {
    private List<MantenimientoResponseDto>? mantenimientos;
    private string search = "", tipoFiltro = "", estadoFiltro = "";
    private int page = 1;
    private IEnumerable<MantenimientoResponseDto> Filtrados => (mantenimientos ?? Enumerable.Empty<MantenimientoResponseDto>()).Where(m =>
        (string.IsNullOrWhiteSpace(search) || m.ActivoDescripcion.Contains(search, StringComparison.OrdinalIgnoreCase) || m.TecnicoNombre.Contains(search, StringComparison.OrdinalIgnoreCase) || m.Descripcion.Contains(search, StringComparison.OrdinalIgnoreCase)) &&
        (string.IsNullOrEmpty(tipoFiltro) || m.Tipo.ToString() == tipoFiltro) &&
        (string.IsNullOrEmpty(estadoFiltro) || m.Estado.ToString() == estadoFiltro));
    private int TotalPages => Math.Max(1, (int)Math.Ceiling(Filtrados.Count() / 5d));

    protected override async Task OnInitializedAsync()
    {
        mantenimientos = (await MantenimientoService.ObtenerTodosAsync()).ToList();
    }

    private void IrARegistrar() => Navigation.NavigateTo("/mantenimiento/registrar");

    private void ResetPage() => page = 1;

    private void IrAFinalizar(Guid id) => Navigation.NavigateTo($"/mantenimiento/finalizar/{id}");

    private string EstadoBadgeClass(EstadoMantenimiento estado) => estado switch
    {
        EstadoMantenimiento.Finalizado => "bg-green-100 text-green-800 dark:bg-green-900/30 dark:text-green-400",
        EstadoMantenimiento.EnProgreso => "bg-amber-100 text-amber-800 dark:bg-amber-900/30 dark:text-amber-400",
        _ => "bg-gray-100 text-gray-800 dark:bg-gray-800 dark:text-gray-300"
    };
}
