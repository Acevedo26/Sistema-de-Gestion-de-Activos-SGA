@page "/categorias/nueva"
@page "/categorias/editar/{Id:guid}"
@attribute [Authorize(Roles = "Administrador,Gestor")]
@inject NavigationManager Navigation
@inject Sistema_de_Gestion_de_Activos.Application.Interfaces.ICategoriaService CategoriaService
@using Sistema_de_Gestion_de_Activos.Application.DTOs.Depreciacion

<PageTitle>@(Id == null ? "Nueva Categoría" : "Editar Vida Útil")</PageTitle>

<div class="max-w-3xl mx-auto p-4 md:p-6">
    <!-- Header -->
    <div class="flex items-center gap-4 mb-6">
        <a href="/categorias" class="text-gray-400 hover:text-gray-600 dark:hover:text-gray-200">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg>
        </a>
        <div>
            <h1 class="text-2xl font-bold text-gray-900 dark:text-white">@(Id == null ? "Nueva Categoría" : "Editar Vida Útil")</h1>
            <p class="text-sm text-gray-500 dark:text-gray-400">@(Id == null ? "Complete la información para registrar una categoría en el sistema." : "Modifique la vida útil estimada para los futuros activos de esta categoría.")</p>
        </div>
    </div>

    <!-- Form Card -->
    <div class="bg-white dark:bg-gray-900 rounded-xl shadow-sm border border-gray-200 dark:border-gray-800 p-6 md:p-8">
        <EditForm Model="form" OnValidSubmit="SaveAsync" class="space-y-8">
            <DataAnnotationsValidator />
            
            @if (!string.IsNullOrEmpty(error))
            {
                <div class="rounded-md bg-red-50 p-4 text-sm text-red-600 dark:bg-red-900/20 dark:text-red-400">@error</div>
            }

            <!-- Section 1 -->
            <div>
                <h3 class="text-lg font-semibold text-primary-600 dark:text-primary-500 mb-6 border-b border-gray-100 dark:border-gray-800 pb-2">Información de la Categoría</h3>
                
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div class="md:col-span-2">
                        <label class="block text-sm font-semibold text-gray-700 dark:text-gray-300 mb-1.5">Nombre <span class="text-red-500">*</span></label>
                        <InputText @bind-Value="form.Nombre" disabled="@(Id != null)" class="w-full rounded-lg border border-gray-300 dark:border-gray-700 bg-white dark:bg-gray-800 px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-primary-500/20 focus:border-primary-500 transition-colors disabled:opacity-60 disabled:cursor-not-allowed" placeholder="Ej. Equipo de Cómputo" />
                        <ValidationMessage For="@(() => form.Nombre)" class="text-red-500 text-xs mt-1" />
                    </div>

                    <div>
                        <label class="block text-sm font-semibold text-gray-700 dark:text-gray-300 mb-1.5">Vida Útil (años) <span class="text-red-500">*</span></label>
                        <InputNumber @bind-Value="form.VidaUtil" class="w-full rounded-lg border border-gray-300 dark:border-gray-700 bg-white dark:bg-gray-800 px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-primary-500/20 focus:border-primary-500 transition-colors" placeholder="Ej. 5" />
                        <ValidationMessage For="@(() => form.VidaUtil)" class="text-red-500 text-xs mt-1" />
                    </div>

                    <div>
                        <label class="block text-sm font-semibold text-gray-700 dark:text-gray-300 mb-1.5">Valor Residual <span class="text-red-500">*</span></label>
                        <InputNumber @bind-Value="form.ValorResidual" disabled="@(Id != null)" class="w-full rounded-lg border border-gray-300 dark:border-gray-700 bg-white dark:bg-gray-800 px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-primary-500/20 focus:border-primary-500 transition-colors disabled:opacity-60 disabled:cursor-not-allowed" placeholder="Ej. 50000" />
                        <ValidationMessage For="@(() => form.ValorResidual)" class="text-red-500 text-xs mt-1" />
                    </div>
                </div>
            </div>

            <div class="pt-6 border-t border-gray-100 dark:border-gray-800 flex justify-end gap-3">
                <a href="/categorias" class="flex items-center gap-2 rounded-lg border border-gray-300 dark:border-gray-700 px-5 py-2.5 text-sm font-medium text-gray-700 dark:text-gray-300 hover:bg-gray-50 dark:hover:bg-gray-800 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary-500 transition-colors">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg> Cancelar
                </a>
                <button type="submit" disabled="@isSubmitting" class="flex items-center gap-2 rounded-lg bg-primary-600 px-5 py-2.5 text-sm font-medium text-white shadow-sm hover:bg-primary-700 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary-500 transition-colors disabled:opacity-50">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"></path><polyline points="17 21 17 13 7 13 7 21"></polyline><polyline points="7 3 7 8 15 8"></polyline></svg> Guardar
                </button>
            </div>
        </EditForm>
    </div>
</div>

@code {
    [Parameter] public Guid? Id { get; set; }
    private CategoriaCreateDto form = new();
    private bool isSubmitting;
    private string error = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        if (Id.HasValue)
        {
            var existing = (await CategoriaService.ObtenerTodasAsync()).FirstOrDefault(c => c.Id == Id.Value);
            if (existing != null)
            {
                form.Nombre = existing.Nombre;
                form.VidaUtil = existing.VidaUtil;
                form.ValorResidual = existing.ValorResidual;
            }
        }
    }

    private async Task SaveAsync()
    {
        error = string.Empty;
        isSubmitting = true;
        try
        {
            if (Id.HasValue)
            {
                await CategoriaService.ActualizarVidaUtilAsync(Id.Value, form.VidaUtil);
            }
            else
            {
                await CategoriaService.CrearAsync(form);
            }
            Navigation.NavigateTo("/depreciacion/categorias");
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            isSubmitting = false;
        }
    }
}