@page "/categorias"
@using Sistema_de_Gestion_de_Activos.Application.ViewModels
@using Sistema_de_Gestion_de_Activos.Application.DTOs.Depreciacion
@using Sistema_de_Gestion_de_Activos.Application.Interfaces
@inject ICategoriaService CategoriaService
@inject NavigationManager Navigation
@inject Sistema_de_Gestion_de_Activos.Application.Interfaces.IAlertService AlertService

<PageTitle>Categorías de activos</PageTitle>

<!-- Header -->
<div class="mb-6">
    <h1 class="text-2xl font-bold text-gray-900 dark:text-white">Categorías de activos</h1>
</div>

<div class="bg-cyan-50 border-l-4 border-cyan-600 text-cyan-900 p-4 mb-6 rounded-r shadow-sm dark:bg-cyan-900/30 dark:border-cyan-500 dark:text-cyan-100" role="alert">
    <div class="flex items-start">
        <svg class="w-5 h-5 mr-2 mt-0.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd"></path></svg>
        <div>
            <span class="font-bold">Nota importante:</span> Modificar la vida útil de una categoría solo aplicará a activos dados de alta a partir de hoy. Los activos existentes conservarán la vida útil asignada originalmente.
        </div>
    </div>
</div>

<!-- Filters Bar -->
<div class="mb-6 rounded-xl border border-gray-200 bg-white p-4 shadow-sm dark:border-gray-800 dark:bg-gray-900">
    <div class="flex flex-col sm:flex-row gap-4">
        <!-- Búsqueda -->
        <div class="relative flex-1">
            <span class="absolute inset-y-0 left-0 flex items-center pl-3 text-gray-400">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
            </span>
            <input type="text" placeholder="Buscar por nombre..." class="w-full rounded-lg border border-gray-200 bg-gray-50 py-2 pl-10 pr-4 text-sm focus:border-primary-500 focus:ring-1 focus:ring-primary-500 dark:border-gray-700 dark:bg-gray-800 dark:text-white" @bind="search" @bind:event="oninput" @bind:after="ResetPage" />
        </div>
    </div>
</div>

<!-- Data Table -->
<div class="overflow-hidden rounded-xl border border-gray-200 bg-white shadow-sm dark:border-gray-800 dark:bg-gray-900">
    <div class="overflow-x-auto min-h-[300px]">
        <table class="w-full text-left text-sm">
            <thead class="border-b border-gray-200 bg-white text-gray-500 dark:border-gray-800 dark:bg-gray-900">
                <tr>
                    <th class="px-6 py-4 font-medium">Nombre</th>
                    <th class="px-6 py-4 font-medium">Vida Útil (años)</th>
                    <th class="px-6 py-4 font-medium text-right">Valor Residual</th>
                    <th class="px-6 py-4 font-medium text-right">Acciones</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-gray-100 dark:divide-gray-800">
                @if (Model?.Categorias != null)
                {
                    @foreach (var c in Filtrados.Skip((page - 1) * 5).Take(5))
                    {
                        <tr class="transition hover:bg-gray-50 dark:hover:bg-gray-800/50">
                            <td class="px-6 py-4 font-medium text-gray-900 dark:text-white">@c.Nombre</td>
                            <td class="px-6 py-4 text-gray-700 dark:text-gray-300">@c.VidaUtil</td>
                            <td class="px-6 py-4 text-right font-medium text-gray-900 dark:text-white">@c.ValorResidual.ToString("C")</td>
                            <td class="px-6 py-4 text-right relative">
                                @if (EsAdmin)
                                {
                                    <div class="flex items-center justify-end gap-2">
                                        <button class="text-gray-400 hover:text-gray-600 dark:hover:text-gray-300" @onclick="() => ToggleMenu(c.Id)"><svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><circle cx="12" cy="12" r="1"></circle><circle cx="12" cy="5" r="1"></circle><circle cx="12" cy="19" r="1"></circle></svg></button>
                                    </div>
                                    @if (openMenuId == c.Id) {
                                        <div class="absolute right-0 top-full mt-1 z-50 w-36 rounded-md bg-white py-1 shadow-lg ring-1 ring-black ring-opacity-5 dark:bg-gray-800 dark:ring-gray-700 text-left">
                                            
                                            <a href="/categorias/editar/@c.Id" class="block w-full text-left px-4 py-2 text-sm text-gray-700 hover:bg-gray-100 dark:text-gray-200 dark:hover:bg-gray-700" @onclick="() => ToggleMenu(null)">Editar</a>
                                            <button class="block w-full text-left px-4 py-2 text-sm text-red-600 hover:bg-gray-100 dark:hover:bg-gray-700" @onclick="() => EliminarPrompt(c)">Eliminar</button>
                                        </div>
                                    }
                                }
                                else
                                {
                                    <span class="text-gray-400 dark:text-gray-500 text-sm inline-flex items-center justify-end gap-1">
                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><rect width="18" height="11" x="3" y="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
                                        Sin permisos
                                    </span>
                                }
                            </td>
                        </tr>
                    }
                    @if (!Filtrados.Any())
                    {
                        <tr>
                            <td colspan="5" class="px-6 py-12 text-center text-gray-500">
                                No se encontraron categorías.
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <!-- Paginación -->
    <div class="flex items-center justify-between border-t border-gray-100 bg-white px-6 py-4 dark:border-gray-800 dark:bg-gray-900">
        <div class="text-sm text-gray-500">
            Mostrando @(((page - 1) * 5) + (Filtrados.Any() ? 1 : 0)) a @Math.Min(page * 5, Filtrados.Count()) de @Filtrados.Count() resultados
        </div>
        <div class="flex items-center gap-1">
            <button class="rounded border border-gray-200 px-2.5 py-1 text-gray-500 hover:bg-gray-50 disabled:opacity-50 dark:border-gray-700 dark:text-gray-400 dark:hover:bg-gray-800" disabled="@(page == 1)" @onclick="() => page--">&lt;</button>
            @for (var i = 1; i <= TotalPages; i++) {
                var current = i;
                <button class="@(current == page ? "rounded bg-primary-600 px-3 py-1 text-white" : "rounded border border-gray-200 px-3 py-1 text-gray-500 hover:bg-gray-50 dark:border-gray-700 dark:text-gray-400 dark:hover:bg-gray-800")" @onclick="() => page = current">@current</button>
            }
            <button class="rounded border border-gray-200 px-2.5 py-1 text-gray-500 hover:bg-gray-50 disabled:opacity-50 dark:border-gray-700 dark:text-gray-400 dark:hover:bg-gray-800" disabled="@(page == TotalPages)" @onclick="() => page++">&gt;</button>
        </div>
    </div>
</div>

<!-- Botón Crear (Abajo derecha) -->
@if (EsAdmin)
{
    <div class="mt-6 flex justify-end">
        <a href="/categorias/nueva" class="flex items-center gap-2 rounded-full bg-primary-600 px-5 py-2.5 text-sm font-medium text-white shadow-sm hover:bg-primary-700 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary-500 transition-colors"><svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg> Nueva Categoría</a>
    </div>
}

<!-- Modals -->
@if (mostrarModal)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-gray-900/50 backdrop-blur-sm transition-opacity">
        <div class="bg-white dark:bg-gray-800 rounded-xl shadow-xl border border-gray-200 dark:border-gray-700 w-full max-w-md overflow-hidden flex flex-col animate-in fade-in zoom-in duration-200">
            <div class="px-6 py-4 border-b border-gray-200 dark:border-gray-700 flex justify-between items-center bg-gray-50 dark:bg-gray-800/50">
                <h5 class="text-lg font-bold text-gray-900 dark:text-white">Editar vida útil</h5>
                <button type="button" class="text-gray-400 hover:text-gray-500 dark:hover:text-gray-300" @onclick="CerrarModal">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
                </button>
            </div>
            
            <div class="p-6 flex-1">
                <div class="space-y-4">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Categoría</label>
                        <input type="text" class="w-full rounded-md border border-gray-300 bg-gray-100 dark:bg-gray-700/50 dark:border-gray-600 dark:text-gray-400 px-3 py-2 text-sm cursor-not-allowed opacity-80" value="@categoriaEditando?.Nombre" disabled />
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Nueva vida útil (años)</label>
                        <input type="number" class="w-full rounded-md border border-gray-300 dark:bg-gray-800 dark:border-gray-600 dark:text-white px-3 py-2 text-sm focus:ring-2 focus:ring-primary-500 focus:border-primary-500" min="1" max="100" @bind="nuevaVidaUtil" required />
                    </div>
                    
                    <div class="bg-amber-50 border-l-4 border-amber-500 text-amber-800 p-3 rounded text-sm dark:bg-amber-900/30 dark:border-amber-500 dark:text-amber-200 flex items-start">
                        <svg class="w-4 h-4 mr-2 mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd"></path></svg>
                        Este cambio solo aplicará a activos nuevos registrados a partir de hoy.
                    </div>
                </div>
            </div>
            
            <div class="px-6 py-4 border-t border-gray-200 dark:border-gray-700 bg-gray-50 dark:bg-gray-800/50 flex justify-end gap-3">
                <button type="button" class="px-4 py-2 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-md shadow-sm hover:bg-gray-50 dark:bg-gray-700 dark:text-gray-200 dark:border-gray-600 dark:hover:bg-gray-600 transition-colors" @onclick="CerrarModal">Cancelar</button>
                <button type="button" class="px-4 py-2 text-sm font-medium text-white bg-primary-600 border border-transparent rounded-md shadow-sm hover:bg-primary-700 transition-colors" @onclick="GuardarCambio">Guardar cambio</button>
            </div>
        </div>
    </div>
}





@code {
    private CategoriaConfigViewModel Model = new();
    private bool mostrarModal = false;
    private CategoriaItemViewModel? categoriaEditando;
    private int nuevaVidaUtil;
    
    private bool EsAdmin = true;
    
    
    private CategoriaCreateDto nuevaCategoria = new();

    private string search = "";
    private int page = 1;
    private Guid? openMenuId;

    private IEnumerable<CategoriaItemViewModel> Filtrados => (Model?.Categorias ?? Enumerable.Empty<CategoriaItemViewModel>()).Where(c => 
        string.IsNullOrWhiteSpace(search) || c.Nombre.Contains(search, StringComparison.OrdinalIgnoreCase));
    
    private int TotalPages => Math.Max(1, (int)Math.Ceiling(Filtrados.Count() / 5d));

    private void ToggleMenu(Guid? id) {
        if (openMenuId == id) openMenuId = null;
        else openMenuId = id;
    }

    private void ResetPage() => page = 1;

    protected override async Task OnInitializedAsync()
    {
        await CargarCategorias();
    }

    private async Task CargarCategorias()
    {
        var categorias = await CategoriaService.ObtenerTodasAsync();
        Model.Categorias = categorias.Select(c => new CategoriaItemViewModel
        {
            Id = c.Id,
            Nombre = c.Nombre,
            VidaUtil = c.VidaUtil,
            ValorResidual = c.ValorResidual
        }).ToList();
    }

    private void CargarEdicion(CategoriaItemViewModel categoria)
    {
        categoriaEditando = categoria;
        nuevaVidaUtil = categoria.VidaUtil;
        mostrarModal = true;
    }

    private void CerrarModal()
    {
        mostrarModal = false;
        categoriaEditando = null;
    }

    private async Task GuardarCambio()
    {
        if (categoriaEditando != null)
        {
            await CategoriaService.ActualizarVidaUtilAsync(categoriaEditando.Id, nuevaVidaUtil);
            await CargarCategorias();
        }
        CerrarModal();
    }

    private async Task GuardarNueva()
    {
        await CategoriaService.CrearAsync(nuevaCategoria);
        nuevaCategoria = new();
        await CargarCategorias();
    }

    private async Task EliminarPrompt(CategoriaItemViewModel cat)
    {
        var confirmed = await AlertService.ConfirmAsync(
            "Eliminar categoría",
            $"¿Desea eliminar la categoría {cat.Nombre}? Solo será posible si no tiene activos asociados."
        );
        if (confirmed)
        {
            try {
                await CategoriaService.EliminarAsync(cat.Id);
                await AlertService.ShowSuccessAsync("Eliminada", "La categoría fue eliminada con éxito.");
                await CargarCategorias();
            } catch(Exception ex) {
                await AlertService.ShowErrorAsync("Error al eliminar", ex.Message);
            }
        }
    }
}
