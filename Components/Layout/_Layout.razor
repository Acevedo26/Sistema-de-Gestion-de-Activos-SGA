@inherits LayoutComponentBase
@inject NavigationManager Navigation
@inject Microsoft.AspNetCore.Components.Authorization.AuthenticationStateProvider AuthStateProvider

<div class="flex h-screen bg-gray-50 dark:bg-gray-950 font-sans text-gray-900 dark:text-gray-100 overflow-hidden">
    
    <!-- Overlay for mobile -->
    @if (isMenuOpen)
    {
        <div class="fixed inset-0 bg-gray-900/50 dark:bg-black/50 z-30 lg:hidden" @onclick="ToggleMenu"></div>
    }

    <!-- Sidebar -->
    <div class="fixed inset-y-0 left-0 z-40 w-64 bg-white dark:bg-gray-900 border-r border-gray-200 dark:border-gray-800 flex flex-col h-full shrink-0 transition-transform duration-300 ease-in-out lg:relative lg:translate-x-0 @(isMenuOpen ? "translate-x-0" : "-translate-x-full")">
        <div class="p-6 h-16 flex items-center justify-between border-b border-gray-100 dark:border-gray-800">
            <h1 class="text-xl font-bold tracking-tight text-gray-900 dark:text-white flex items-center gap-3">
                <div class="w-8 h-8 rounded bg-primary-600 flex items-center justify-center text-white">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M10 22v-9.5a.5.5 0 0 0-.5-.5h-2a.5.5 0 0 0-.5.5V22" />
                        <path d="M4 22h16" />
                        <path d="M14 22v-5.5a.5.5 0 0 1 .5-.5h2a.5.5 0 0 1 .5.5V22" />
                        <path d="M6 12h12a2 2 0 0 0 2-2V5a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v5a2 2 0 0 0 2 2Z" />
                        <path d="M6 8h2" />
                        <path d="M16 8h2" />
                        <path d="M6 12h2" />
                        <path d="M16 12h2" />
                    </svg>
                </div>
                SGA Corp
            </h1>
            <button class="lg:hidden text-gray-500" @onclick="ToggleMenu">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"></path></svg>
            </button>
        </div>

        <div class="flex-1 overflow-y-auto py-6 px-4 space-y-2">
            <NavLink href="/dashboard" Match="NavLinkMatch.All" class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium text-gray-600 hover:text-gray-900 hover:bg-gray-50 dark:text-gray-300 dark:hover:bg-gray-800 transition-colors" ActiveClass="bg-primary-50 text-primary-600 dark:bg-primary-900/30 dark:text-primary-400" @onclick="CloseMenuOnMobile">
                <svg class="w-5 h-5 opacity-70" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path><polyline points="9 22 9 12 15 12 15 22"></polyline></svg>
                Dashboard
            </NavLink>

            <NavLink href="/activos" class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium text-gray-600 hover:text-gray-900 hover:bg-gray-50 dark:text-gray-300 dark:hover:bg-gray-800 transition-colors" ActiveClass="bg-primary-50 text-primary-600 dark:bg-primary-900/30 dark:text-primary-400" @onclick="CloseMenuOnMobile">
                <svg class="w-5 h-5 opacity-70" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path><polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline><line x1="12" y1="22.08" x2="12" y2="12"></line></svg>
                Activos
            </NavLink>

            <NavLink href="/mantenimientos" class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium text-gray-600 hover:text-gray-900 hover:bg-gray-50 dark:text-gray-300 dark:hover:bg-gray-800 transition-colors" ActiveClass="bg-primary-50 text-primary-600 dark:bg-primary-900/30 dark:text-primary-400" @onclick="CloseMenuOnMobile">
                <svg class="w-5 h-5 opacity-70" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"></path></svg>
                Mantenimiento
            </NavLink>
            
            <NavLink href="/categorias" class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium text-gray-600 hover:text-gray-900 hover:bg-gray-50 dark:text-gray-300 dark:hover:bg-gray-800 transition-colors" ActiveClass="bg-primary-50 text-primary-600 dark:bg-primary-900/30 dark:text-primary-400" @onclick="CloseMenuOnMobile">
                <svg class="w-5 h-5 opacity-70" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round"><path d="M20 7h-9"></path><path d="M14 17H5"></path><circle cx="17" cy="17" r="3"></circle><circle cx="9" cy="7" r="3"></circle></svg>
                Categorías
            </NavLink>
            
            <button type="button" @onclick="() => reportesExpandido = !reportesExpandido" class="w-full flex items-center justify-between gap-3 px-3 py-2.5 rounded-lg text-sm font-medium text-gray-600 hover:text-gray-900 hover:bg-gray-50 dark:text-gray-300 dark:hover:bg-gray-800 transition-colors">
                <span class="flex items-center gap-3">
                    <svg class="w-5 h-5 opacity-70" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>
                    Reportes
                </span>
                <svg class="w-4 h-4 opacity-70 transition-transform @(reportesExpandido ? "rotate-90" : "")" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
            </button>

            @if (reportesExpandido)
            {
                <div class="ml-6 space-y-1 border-l border-gray-200 dark:border-gray-700 pl-3">
                    <NavLink href="/reportes/depreciacion" class="flex items-center gap-2.5 px-3 py-2 rounded-lg text-sm font-medium text-gray-600 hover:text-gray-900 hover:bg-gray-50 dark:text-gray-300 dark:hover:bg-gray-800 transition-colors" ActiveClass="bg-primary-50 text-primary-600 dark:bg-primary-900/30 dark:text-primary-400" @onclick="CloseMenuOnMobile">
                        <svg class="w-4 h-4 opacity-70" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"></polyline></svg>
                        Depreciación
                    </NavLink>
                    <NavLink href="/reportes/inventario" class="flex items-center gap-2.5 px-3 py-2 rounded-lg text-sm font-medium text-gray-600 hover:text-gray-900 hover:bg-gray-50 dark:text-gray-300 dark:hover:bg-gray-800 transition-colors" ActiveClass="bg-primary-50 text-primary-600 dark:bg-primary-900/30 dark:text-primary-400" @onclick="CloseMenuOnMobile">
                        <svg class="w-4 h-4 opacity-70" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path><polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline><line x1="12" y1="22.08" x2="12" y2="12"></line></svg>
                        Inventario
                    </NavLink>
                    <NavLink href="/reportes/mantenimientos" class="flex items-center gap-2.5 px-3 py-2 rounded-lg text-sm font-medium text-gray-600 hover:text-gray-900 hover:bg-gray-50 dark:text-gray-300 dark:hover:bg-gray-800 transition-colors" ActiveClass="bg-primary-50 text-primary-600 dark:bg-primary-900/30 dark:text-primary-400" @onclick="CloseMenuOnMobile">
                        <svg class="w-4 h-4 opacity-70" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"></path></svg>
                        Mantenimientos
                    </NavLink>
                </div>
            }

            <NavLink href="/administracion" class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium text-gray-600 hover:text-gray-900 hover:bg-gray-50 dark:text-gray-300 dark:hover:bg-gray-800 transition-colors" ActiveClass="bg-primary-50 text-primary-600 dark:bg-primary-900/30 dark:text-primary-400" @onclick="CloseMenuOnMobile">
                <svg class="w-5 h-5 opacity-70" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round"><path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z"></path><circle cx="12" cy="12" r="3"></circle></svg>
                Administración
            </NavLink>
        </div>

        <div class="p-6 border-t border-gray-100 dark:border-gray-800">
            <AuthorizeView Context="auth">
                <Authorized>
                    <div class="flex items-center gap-3 mb-6">
                        <div class="w-10 h-10 rounded-full bg-primary-100 dark:bg-primary-900/50 flex items-center justify-center text-primary-700 dark:text-primary-300 font-bold">
                            @Initial(auth.User.Identity?.Name)
                        </div>
                        <div class="flex-1 min-w-0">
                            <p class="text-sm font-bold text-gray-900 dark:text-white truncate">@auth.User.Identity?.Name</p>
                            <p class="text-xs text-gray-500 dark:text-gray-400 truncate">@auth.User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value</p>
                        </div>
                    </div>
                </Authorized>
            </AuthorizeView>
            <button class="flex items-center gap-3 text-sm font-bold text-red-600 hover:text-red-700 transition-colors w-full focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-red-500 rounded" @onclick="CerrarSesion">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path><polyline points="16 17 21 12 16 7"></polyline><line x1="21" y1="12" x2="9" y2="12"></line></svg>
                Cerrar Sesión
            </button>
        </div>
    </div>

    <!-- Main Content -->
    <div class="flex-1 flex flex-col h-full overflow-hidden w-full">
        <!-- Topbar -->
        <header class="bg-white dark:bg-gray-900 border-b border-gray-100 dark:border-gray-800 h-16 flex items-center justify-between px-4 md:px-8 shrink-0 z-10 w-full">
            <div class="flex items-center text-gray-900 dark:text-white font-bold text-lg">
                <button class="lg:hidden text-gray-500 hover:text-gray-700 dark:text-gray-400 dark:hover:text-gray-200 mr-4 focus:outline-none" @onclick="ToggleMenu">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16"></path></svg>
                </button>
                <a href="/dashboard" class="w-8 h-8 rounded bg-primary-600 flex items-center justify-center text-white lg:hidden mr-4">
                    SG
                </a>
            </div>
            <div class="flex items-center gap-6">
                <GlobalSearch />
                <ThemeToggle />
                <NotificationPanel />
                <div class="h-6 w-px bg-gray-200 dark:bg-gray-700 hidden md:block"></div>
                <AuthorizeView Context="auth">
                    <Authorized>
                        <a href="/perfil" class="w-8 h-8 rounded-full bg-primary-100 dark:bg-primary-900/50 flex items-center justify-center text-primary-700 dark:text-primary-300 font-bold transition hover:ring-2 hover:ring-primary-400" aria-label="Ver perfil">
                            @Initial(auth.User.Identity?.Name)
                        </a>
                    </Authorized>
                </AuthorizeView>
            </div>
        </header>
        <main class="flex-1 overflow-y-auto p-4 md:p-8 relative">
            <div class="mx-auto max-w-7xl">
                @Body
            </div>
        </main>
    </div>
</div>

@code {
    private bool reportesExpandido;
    private bool isMenuOpen = false;

    private static string Initial(string? name) => string.IsNullOrWhiteSpace(name) ? "U" : name[..1].ToUpperInvariant();

    private void ToggleMenu()
    {
        isMenuOpen = !isMenuOpen;
    }

    private void CloseMenuOnMobile()
    {
        isMenuOpen = false;
    }

    private async Task CerrarSesion()
    {
        if (AuthStateProvider is Sistema_de_Gestion_de_Activos.Providers.CustomAuthStateProvider provider) await provider.MarkUserAsLoggedOut();
        Navigation.NavigateTo("/login", forceLoad: true);
    }
}
