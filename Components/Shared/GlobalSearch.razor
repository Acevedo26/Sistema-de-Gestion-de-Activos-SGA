@using Sistema_de_Gestion_de_Activos.Application.Interfaces
@inject IActivoService ActivoService
@inject IMantenimientoService MantenimientoService
@inject ICategoriaService CategoriaService

<button type="button" class="text-gray-400 hover:text-gray-600 dark:hover:text-gray-300 focus-visible:outline-none" @onclick="Abrir" aria-label="Buscar en el sistema" title="Buscar">
    <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
</button>

@if (_isOpen)
{
    <div class="fixed inset-0 z-50 flex items-start justify-center pt-16 sm:pt-24" aria-modal="true" role="dialog">
        <div class="fixed inset-0 bg-gray-900/50 backdrop-blur-sm transition-opacity" @onclick="Cerrar"></div>
        
        <div class="relative w-full max-w-xl overflow-hidden rounded-2xl bg-white shadow-2xl ring-1 ring-black/5 dark:bg-gray-800 dark:ring-white/10 mx-4">
            <div class="flex items-center border-b border-gray-100 px-4 dark:border-gray-800">
                <input id="global-search" @ref="searchInput" @bind="query" @bind:event="oninput" @bind:after="Search" autocomplete="off" placeholder="Buscar activos, mantenimientos o categorías..." class="w-full border-0 bg-transparent py-4 pl-4 pr-4 text-gray-900 placeholder:text-gray-400 focus:ring-0 sm:text-sm dark:text-white outline-none" />
            </div>
            
            @if (results.Count > 0)
            {
                <div class="max-h-96 overflow-y-auto py-2">
                    @foreach (var result in results)
                    {
                        <a href="@result.Url" @onclick="Cerrar" class="block px-4 py-3 text-sm hover:bg-gray-50 dark:hover:bg-gray-800/50">
                            <span class="font-medium text-gray-900 dark:text-white">@result.Title</span>
                            <span class="ml-2 text-xs text-gray-500">@result.Type</span>
                        </a>
                    }
                </div>
            }
            else if (!string.IsNullOrWhiteSpace(query))
            {
                <div class="p-6 text-center text-sm text-gray-500">
                    No se encontraron resultados para "@query"
                </div>
            }
        </div>
    </div>
}

@code {
    private bool _isOpen;
    private string query = string.Empty;
    private List<SearchResult> results = new();
    private ElementReference searchInput;

    private async Task Abrir()
    {
        _isOpen = true;
        query = string.Empty;
        results.Clear();
        // focus logic can be handled via JS if needed
    }

    private void Cerrar()
    {
        _isOpen = false;
        query = string.Empty;
        results.Clear();
    }

    private async Task Search()
    {
        if (query.Trim().Length < 2) { results.Clear(); return; }
        var term = query.Trim();
        var activos = await ActivoService.ObtenerTodosAsync();
        var mantenimientos = await MantenimientoService.ObtenerTodosAsync();
        var categorias = await CategoriaService.ObtenerTodasAsync();
        results = activos.Where(x => x.Codigo.Contains(term, StringComparison.OrdinalIgnoreCase) || x.Descripcion.Contains(term, StringComparison.OrdinalIgnoreCase))
            .Take(4).Select(x => new SearchResult($"{x.Codigo} · {x.Descripcion}", "Activo", $"/activos/{x.Id}/depreciacion"))
            .Concat(mantenimientos.Where(x => x.ActivoDescripcion.Contains(term, StringComparison.OrdinalIgnoreCase) || x.Descripcion.Contains(term, StringComparison.OrdinalIgnoreCase))
                .Take(3).Select(x => new SearchResult($"{x.ActivoDescripcion} · {x.Descripcion}", "Mantenimiento", "/mantenimientos")))
            .Concat(categorias.Where(x => x.Nombre.Contains(term, StringComparison.OrdinalIgnoreCase))
                .Take(3).Select(x => new SearchResult(x.Nombre, "Categoría", "/categorias")))
            .Take(8).ToList();
    }

    private sealed record SearchResult(string Title, string Type, string Url);
}
