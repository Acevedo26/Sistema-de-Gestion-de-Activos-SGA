@using Sistema_de_Gestion_de_Activos.Application.DTOs.Maestros
@inject Sistema_de_Gestion_de_Activos.Application.Interfaces.INotificationService NotificationService

<div class="relative">
    <button type="button" class="text-gray-400 hover:text-gray-600 dark:hover:text-gray-300 relative focus-visible:outline-none" @onclick="Toggle" aria-label="Notificaciones" title="Notificaciones">
        @if (unread > 0)
        {
            <span class="absolute top-0 right-1 w-2 h-2 bg-red-500 rounded-full border border-white dark:border-gray-900"></span>
        }
        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path><path d="M13.73 21a2 2 0 0 1-3.46 0"></path></svg>
    </button>
    @if (open)
    {
        <section class="absolute right-0 z-50 mt-2 w-80 overflow-hidden rounded-xl border border-gray-200 bg-white shadow-xl dark:border-gray-700 dark:bg-gray-900" aria-label="Panel de notificaciones">
            <div class="flex items-center justify-between border-b border-gray-100 px-4 py-3 dark:border-gray-800"><h2 class="font-semibold">Notificaciones</h2><button class="text-xs font-medium text-primary-600 hover:underline" @onclick="MarkAll">Marcar todas</button></div>
            <div class="max-h-96 overflow-y-auto">
                @if (items.Count == 0) { <p class="p-6 text-center text-sm text-gray-500">No hay notificaciones.</p> }
                @foreach (var item in items)
                {
                    <button class="block w-full border-b border-gray-100 px-4 py-3 text-left text-sm transition hover:bg-gray-50 dark:border-gray-800 dark:hover:bg-gray-800 @(item.Leida ? "opacity-60" : "")" @onclick="() => MarkRead(item.Id)">
                        <span class="block font-medium text-gray-900 dark:text-white">@item.Mensaje</span><span class="mt-1 block text-xs text-gray-500">@item.FechaGeneracion.ToLocalTime().ToString("dd/MM HH:mm")</span>
                    </button>
                }
            </div>
        </section>
    }
</div>

@code {
    private bool open;
    private int unread;
    private List<NotificacionDto> items = new();
    protected override async Task OnInitializedAsync() => await Load();
    private async Task Load() { items = (await NotificationService.ObtenerRecientesAsync()).ToList(); unread = items.Count(x => !x.Leida); }
    private async Task Toggle() { open = !open; if (open) await Load(); }
    private async Task MarkRead(Guid id) { await NotificationService.MarcarComoLeidaAsync(id); await Load(); }
    private async Task MarkAll() { await NotificationService.MarcarTodasComoLeidasAsync(); await Load(); }
}
