<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg" href="images/Vector.svg" />
    <title>SGA Corp</title>
    <base href="/" />
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
            tailwind.config = {
                darkMode: 'class',
                theme: {
                    extend: {
                        colors: {
                            primary: {
                                50: '#f0fdfa',
                                100: '#ccfbf1',
                                200: '#99f6e4',
                                300: '#5eead4',
                                400: '#2dd4bf',
                                500: '#14b8a6',
                                600: '#0d9488',
                                700: '#0f766e',
                                800: '#115e59',
                                900: '#134e4a',
                                950: '#042f2e',
                            }
                        }
                    }
                }
            }
    </script>
    <HeadOutlet @rendermode="new InteractiveServerRenderMode(prerender: false)" />
    <style>
            /* Personalización de scrollbars */
            :root {
                scrollbar-color: #0d9488 #f3f4f6;
                scrollbar-width: thin;
            }

            .dark {
                scrollbar-color: #0d9488 #374151;
            }

            ::-webkit-scrollbar {
                width: 8px;
                height: 8px;
            }

            ::-webkit-scrollbar-track {
                background: #f3f4f6;
                border-radius: 4px;
            }

            .dark ::-webkit-scrollbar-track {
                background: #374151;
            }

            ::-webkit-scrollbar-thumb {
                background: #0d9488;
                border-radius: 4px;
            }

                ::-webkit-scrollbar-thumb:hover {
                    background: #0f766e;
                }

            /* Estilo para los selects nativos */
            select {
                appearance: none;
                background-image: url("data:image/svg+xml;charset=UTF-8,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'%3e%3cpolyline points='6 9 12 15 18 9'%3e%3c/polyline%3e%3c/svg%3e");
                background-repeat: no-repeat;
                background-position: right 0.75rem center;
                background-size: 1em;
            }

            /* Forzar modo oscuro en inputs/selects/textareas sin clases explícitas */
            .dark input, .dark select, .dark textarea {
                background-color: #374151 !important; /* gray-700 */
                color: #ffffff !important;
                border-color: #4b5563 !important; /* gray-600 */
            }

                .dark input:focus, .dark select:focus, .dark textarea:focus {
                    --tw-ring-color: #0d9488 !important; /* green-500 */
                    border-color: #0d9488 !important;
                }

            /* En app.css o similar */
            .dark .custom-input {
                background-color: #374151; /* gray-700 */
                color: #f3f4f6; /* white */
            }
            /* Forzar fondo y texto para campos autocompletados */
            input:-webkit-autofill,
            input:-webkit-autofill:hover,
            input:-webkit-autofill:focus,
            input:-webkit-autofill:active {
                -webkit-box-shadow: 0 0 0 1000px white inset !important;
                -webkit-text-fill-color: #111827 !important; /* gray-900 */
                caret-color: #111827;
            }

            /* Modo oscuro */
            .dark input:-webkit-autofill,
            .dark input:-webkit-autofill:hover,
            .dark input:-webkit-autofill:focus,
            .dark input:-webkit-autofill:active {
                -webkit-box-shadow: 0 0 0 1000px #374151 inset !important; /* gray-700 */
                -webkit-text-fill-color: #f9fafb !important; /* gray-50 */
                caret-color: #f9fafb;
            }

            /* Para Firefox */
            input:-moz-autofill,
            input:-moz-autofill:hover,
            input:-moz-autofill:focus,
            input:-moz-autofill:active {
                box-shadow: 0 0 0 1000px white inset !important;
                color: #111827 !important;
            }

            .dark input:-moz-autofill {
                box-shadow: 0 0 0 1000px #374151 inset !important;
                color: #f9fafb !important;
            }
    </style>
</head>
<body class="bg-gray-50 text-gray-950 antialiased dark:bg-gray-950 dark:text-gray-50">
    <Routes @rendermode="new InteractiveServerRenderMode(prerender: false)" />
    <script src="_framework/blazor.web.js"></script>
    <script>
            window.sgaTheme = {
                get: () => localStorage.getItem('sga-theme') || 'light',
                set: (theme) => {
                    localStorage.setItem('sga-theme', theme);
                    document.documentElement.classList.toggle('dark', theme === 'dark');
                },
                initialize: () => {
                    const saved = localStorage.getItem('sga-theme');
                    const theme = saved || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
                    document.documentElement.classList.toggle('dark', theme === 'dark');
                    return theme;
                }
            };
            window.sgaTheme.initialize();
            window.downloadFileFromBase64 = function(filename, base64) {
                const link = document.createElement('a');
                link.download = filename;
                link.href = "data:application/octet-stream;base64," + base64;
                document.body.appendChild(link);
                link.click();
                document.body.removeChild(link);
            }
    </script>
    <script src="https://cdn.jsdelivr.net/npm/apexcharts"></script>
    <script>
            window.renderAssetChart = function(chartId, dataValues, labels) {
                if(document.getElementById(chartId) && typeof ApexCharts !== 'undefined') {
                    var options = {
                        chart: { height: 200, type: "area", fontFamily: "Inter, sans-serif", dropShadow: { enabled: false }, toolbar: { show: false } },
                        tooltip: { enabled: true, y: { formatter: function(val) { return "₡" + val.toLocaleString('es-CR'); } } },
                        fill: { type: "gradient", gradient: { opacityFrom: 0.55, opacityTo: 0, shade: "#0d9488", gradientToColors: ["#0d9488"] } },
                        dataLabels: { enabled: false },
                        stroke: { width: 3, colors: ["#0d9488"] },
                        grid: { show: false },
                        series: [{ name: "Valor", data: dataValues, color: "#0d9488" }],
                        xaxis: { categories: labels, labels: { show: true, style: { cssClass: 'text-xs font-normal fill-gray-500 dark:fill-gray-400' } }, axisBorder: { show: false }, axisTicks: { show: false } },
                        yaxis: { show: false }
                    };
                    document.getElementById(chartId).innerHTML = '';
                    var chart = new ApexCharts(document.getElementById(chartId), options);
                    chart.render();
                }
            }
        // Registro global de gráficos para actualizarlos al cambiar el tema
        window.sgaCharts = window.sgaCharts || {};

        document.addEventListener("DOMContentLoaded", function() {
            const observer = new MutationObserver(function(mutations) {
                mutations.forEach(function(mutation) {
                    if (mutation.attributeName === "class") {
                        for (const id in window.sgaCharts) {
                            const chartData = window.sgaCharts[id];
                            if (document.getElementById(id)) {
                                if (chartData.type === 'area') {
                                    window.renderFlowbiteAreaChart(id, chartData.dataValues, chartData.labels, chartData.prefix);
                                } else if (chartData.type === 'donut') {
                                    window.renderFlowbiteDonutChart(id, chartData.dataValues, chartData.labels);
                                }
                            }
                        }
                    }
                });
            });
            observer.observe(document.documentElement, { attributes: true, attributeFilter: ['class'] });
        });

        window.renderFlowbiteAreaChart = function(chartId, dataValues, labels, prefix) {
            if(document.getElementById(chartId) && typeof ApexCharts !== 'undefined') {
                const isDark = document.documentElement.classList.contains('dark');
                var options = {
                    theme: { mode: isDark ? 'dark' : 'light' },
                    chart: { height: 150, type: "area", fontFamily: "Inter, sans-serif", dropShadow: { enabled: false }, toolbar: { show: false }, background: 'transparent' },
                    tooltip: { theme: isDark ? 'dark' : 'light', enabled: true, x: { show: false }, y: { formatter: function(val) { return prefix ? prefix + val.toLocaleString('es-CR') : val.toLocaleString('es-CR'); } } },
                    fill: { type: "gradient", gradient: { opacityFrom: 0.55, opacityTo: 0, shade: "#0d9488", gradientToColors: ["#0d9488"] } },
                    dataLabels: { enabled: false },
                    stroke: { width: 4, colors: ["#0d9488"] },
                    grid: { show: false, padding: { left: 0, right: 0, top: 0, bottom: 0 } },
                    series: [{ name: "Valor", data: dataValues, color: "#0d9488" }],
                    xaxis: { categories: labels, labels: { show: false }, axisBorder: { show: false }, axisTicks: { show: false }, tooltip: { enabled: false } },
                    yaxis: { show: false }
                };
                document.getElementById(chartId).innerHTML = '';
                var chart = new ApexCharts(document.getElementById(chartId), options);
                chart.render();
                window.sgaCharts[chartId] = { type: 'area', dataValues: dataValues, labels: labels, prefix: prefix };
            }
        }

        window.renderFlowbiteDonutChart = function(chartId, dataValues, labels) {
            if(document.getElementById(chartId) && typeof ApexCharts !== 'undefined') {
                const isDark = document.documentElement.classList.contains('dark');
                var options = {
                    theme: { mode: isDark ? 'dark' : 'light' },
                    series: dataValues,
                    colors: isDark ? ["#0d9488", "#374151"] : ["#0d9488", "#f3f4f6"],
                    chart: { background: 'transparent', height: 250, width: "100%", type: "donut", fontFamily: "Inter, sans-serif" },
                    stroke: { colors: ["transparent"], lineCap: "" },
                    plotOptions: {
                        pie: {
                            donut: {
                                labels: {
                                    show: true,
                                    name: {
                                        show: true,
                                        fontFamily: "Inter, sans-serif",
                                        offsetY: 20,
                                        color: isDark ? '#9ca3af' : '#6b7280'
                                    },
                                    total: {
                                        showAlways: true,
                                        show: true,
                                        label: "Activos",
                                        fontFamily: "Inter, sans-serif",
                                        color: isDark ? '#ffffff' : '#1f2937',
                                        formatter: function (w) { return w.globals.seriesTotals.reduce((a, b) => a + b, 0); }
                                    },
                                    value: {
                                        show: true,
                                        fontFamily: "Inter, sans-serif",
                                        offsetY: -20,
                                        color: isDark ? '#ffffff' : '#1f2937',
                                        formatter: function (value) { return value; }
                                    }
                                },
                                size: "80%"
                            }
                        }
                    },
                    labels: labels,
                    dataLabels: { enabled: false },
                    legend: { show: false }
                };
                document.getElementById(chartId).innerHTML = '';
                var chart = new ApexCharts(document.getElementById(chartId), options);
                chart.render();
                window.sgaCharts[chartId] = { type: 'donut', dataValues: dataValues, labels: labels };
            }
        }
    </script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        // Obtiene la configuración base corporativa de SweetAlert2 evaluando el modo oscuro
        function getSwalConfig(isDanger = false) {
            const isDark = document.documentElement.classList.contains('dark');
            
            // Botón primario: Si es acción de peligro (eliminar), usa rojo. Si no, verde corporativo (#0d9488 / primary-600)
            const confirmBtnClass = isDanger 
                ? 'bg-red-500 hover:bg-red-600 text-white font-medium rounded-lg text-sm px-5 py-2.5 text-center transition-colors shadow-sm focus:ring-4 focus:ring-red-300 dark:focus:ring-red-800 mx-1'
                : 'bg-primary-600 hover:bg-primary-700 text-white font-medium rounded-lg text-sm px-5 py-2.5 text-center transition-colors shadow-sm focus:ring-4 focus:ring-primary-300 dark:focus:ring-primary-800 mx-1';
            
            // Botón secundario: Gris oscuro en dark mode, gris claro en light mode
            const cancelBtnClass = isDark
                ? 'bg-gray-700 hover:bg-gray-600 text-gray-200 border border-gray-600 font-medium rounded-lg text-sm px-5 py-2.5 text-center transition-colors focus:ring-4 focus:ring-gray-600 mx-1'
                : 'bg-white hover:bg-gray-100 text-gray-700 border border-gray-300 font-medium rounded-lg text-sm px-5 py-2.5 text-center transition-colors focus:ring-4 focus:ring-gray-200 mx-1';

            return {
                buttonsStyling: false,
                background: isDark ? '#1f2937' : '#ffffff', // Fondo gris oscuro o blanco
                color: isDark ? '#f9fafb' : '#1f2937',      // Texto claro u oscuro
                customClass: {
                    popup: isDark ? 'border border-gray-700 shadow-2xl rounded-xl' : 'shadow-2xl rounded-xl border border-gray-100',
                    title: isDark ? 'text-white font-bold' : 'text-primary-700 font-bold',
                    htmlContainer: isDark ? 'text-gray-300 text-sm' : 'text-gray-600 text-sm',
                    confirmButton: confirmBtnClass,
                    cancelButton: cancelBtnClass,
                    actions: 'gap-3 mt-6'
                }
            };
        }

        window.sgaAlerts = {
            success: function(title, text) {
                return Swal.fire(Object.assign({ title: title, text: text, icon: 'success' }, getSwalConfig()));
            },
            error: function(title, text) {
                return Swal.fire(Object.assign({ title: title, text: text, icon: 'error' }, getSwalConfig()));
            },
            warning: function(title, text) {
                return Swal.fire(Object.assign({ title: title, text: text, icon: 'warning' }, getSwalConfig()));
            },
            confirm: function(title, text, icon, confirmButtonText, cancelButtonText) {
                // Inferimos si es una acción de "Peligro" basándonos en el título, texto o color del ícono
                const isDanger = (icon === 'error') || 
                                 (title && title.toLowerCase().includes('eliminar')) || 
                                 (confirmButtonText && confirmButtonText.toLowerCase().includes('eliminar'));

                return Swal.fire(Object.assign({
                    title: title,
                    text: text,
                    icon: icon || 'warning',
                    showCancelButton: true,
                    confirmButtonText: confirmButtonText || 'Confirmar',
                    cancelButtonText: cancelButtonText || 'Cancelar'
                }, getSwalConfig(isDanger))).then(function(result) {
                    return result.isConfirmed;
                });
            }
        };
    </script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/lottie-web/5.13.0/lottie.min.js"></script>
    <script>
        window.loadLottieAnimation = (containerId, animationUrl) => {
            lottie.loadAnimation({
                container: document.getElementById(containerId),
                renderer: 'svg',
                loop: true,
                autoplay: true,
                path: animationUrl
            });
        };
    </script>
</body>
</html>
