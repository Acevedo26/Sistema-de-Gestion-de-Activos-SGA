<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Sistema de Gestión de Activos</title>
    <base href="/" />
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        primary: {
                            50: '#f0fdfa',
                            100: '#ccfbf1',
                            200: '#99f6e4',
                            300: '#5eead4',
                            400: '#2dd4bf',
                            500: '#14b8a6',
                            600: '#0d9488',
                            700: '#0f766e',
                            800: '#115e59',
                            900: '#134e4a',
                            950: '#042f2e',
                        }
                    }
                }
            }
        }
    </script>
    <HeadOutlet @rendermode="new InteractiveServerRenderMode(prerender: false)" />
</head>
<body class="bg-gray-50 text-gray-950 antialiased dark:bg-gray-950 dark:text-gray-50">
    <Routes @rendermode="new InteractiveServerRenderMode(prerender: false)" />
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>`n    <script src="_framework/blazor.web.js"></script>
    <script>
        window.sgaTheme = {
            get: () => localStorage.getItem('sga-theme') || 'light',
            set: (theme) => {
                localStorage.setItem('sga-theme', theme);
                document.documentElement.classList.toggle('dark', theme === 'dark');
            },
            initialize: () => {
                const saved = localStorage.getItem('sga-theme');
                const theme = saved || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
                document.documentElement.classList.toggle('dark', theme === 'dark');
                return theme;
            }
        };
        window.sgaTheme.initialize();
                window.sgaAlerts = {
            confirm: function(title, text, icon, confirmText, cancelText) {
                return Swal.fire({
                    title: title,
                    text: text,
                    icon: icon,
                    showCancelButton: true,
                    confirmButtonColor: '#0d9488',
                    cancelButtonColor: '#6b7280',
                    confirmButtonText: confirmText,
                    cancelButtonText: cancelText
                }).then(function(result) {
                    return result.isConfirmed;
                });
            },
            success: function(title, text) {
                return Swal.fire({
                    toast: true,
                    position: 'top-end',
                    showConfirmButton: false,
                    timer: 3000,
                    timerProgressBar: true,
                    icon: 'success',
                    title: title,
                    text: text
                });
            },
            error: function(title, text) {
                return Swal.fire({
                    icon: 'error',
                    title: title,
                    text: text,
                    confirmButtonColor: '#0d9488'
                });
            },
            warning: function(title, text) {
                return Swal.fire({
                    icon: 'warning',
                    title: title,
                    text: text,
                    confirmButtonColor: '#0d9488'
                });
            }
        };
        window.downloadFileFromBase64 = function(filename, base64) {
            const link = document.createElement('a');
            link.download = filename;
            link.href = "data:application/octet-stream;base64," + base64;
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
        }
    </script>
</body>
</html>
